<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/atti.css"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window apply="grailsBindComposer"
        viewModel="@id('vm') @init('popupCorteContiDaInviareViewModel')"
		border="normal"
        width="600px"
        title=" ">

		<vlayout hflex="1" vflex="1">
			<div sclass="barraTitoloPagina">
				<label sclass="titoloPagina" value="@load(c:l('label.corteConti.daInviare'))" />
			</div>

			<grid hflex="1">
				<rows>
					<row>
						<cell width="200px">
							<label value="@load(c:l('label.corteConti.daInviare'))" />
						</cell>
						<cell>
							<radiogroup selectedIndex="@load(vm.daInviareCorteConti ? 0 : 1)" selectedItem="@save(vm.daInviareCorteConti)">
								<radio label="Sì" value="@load(true)"  />
								<radio label="No" value="@load(false)" />
							</radiogroup>
						</cell>
					</row>
					<row>
						<cell>
							<label value="@load(c:l('label.corteConti.dataInvio'))" />
						</cell>
						<cell>
							<datebox value="@bind(vm.dataInvioCorteConti)" format="dd/MM/yyyy" />
						</cell>
					</row>
				</rows>
			</grid>

			<h:div class="barraPulsanti">
				<h:div>
					<button mold="trendy" label="Salva"  onClick="@command('onSalva')"/>
					<button mold="trendy" label="Chiudi" onClick="@command('onChiudi')" />
				</h:div>
			</h:div>
		</vlayout>
    </window>
</zk>