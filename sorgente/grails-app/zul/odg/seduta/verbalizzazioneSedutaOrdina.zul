<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window apply="grailsBindComposer" vflex="1" viewModel="@id('vm') @init('odgVerbalizzazioneSedutaOrdinaViewModel')">
		<hlayout hflex="1" vflex="1">
			<vlayout hflex="1" vflex="1">
				<hlayout vflex="1" hflex="1">
				 	<listbox id="listaProposte" hflex="1" vflex="1"
				 		multiple="false" checkmark="true" nonselectableTags="*"
						onSelect="@command('settaSelezione', lista=listaProposte)"
						model="@bind(vm.listaProposte)"
						selectedItem="@bind(vm.selectedProposta)"
						emptyMessage="Nessun dato trovato">
						<listhead>
							<listheader label="" width="30px"/>
							<listheader label="" width="30px" />
					 		<listheader label="@load(c:l('label.proposta'))" hflex="5"/>
							<listheader label="Esito" hflex="2" />
							<listheader label="Delibera" hflex="3" />
						</listhead>
						<template name="model">
							<listitem draggable="@bind(vm.isDrop)" droppable="@bind(vm.isDrop)"
								attributes.item="@load(each)" value="@load(each)"
								onDrop="@command('spostaOggetto', base=each)">
								<listcell/>
							 	<listcell style="text-align: center">
									<image src="@load(each.iconaStatoOdg.url)" tooltiptext="@load(each.iconaStatoOdg.tooltip)"/>
								</listcell>
								<listcell>
									<vlayout hflex="1">
										<label value="@load(not empty each.propostaDelibera ? c:cat4(c:cat3(c:cat(c:l('label.proposta'),' n. '), each.propostaDelibera.numeroProposta, '/'), each.propostaDelibera.annoProposta, ' - ', each.propostaDelibera.tipologia.titolo) : c:cat4(c:cat3('Determina n. ', each.determina.numeroProposta, '/'), each.determina.annoProposta, ' - ', each.determina.tipologia.titolo))"
											style=" color:black;" />
						                <label value="@load(each.getClass().getSimpleName() eq 'PropostaDeliberaDTO' ? c:cat3('Relatore', ': ', each.delega.assessore.denominazione) : '')" visible="@load(each.getClass().getSimpleName() eq 'PropostaDeliberaDTO' and not empty each.delega.assessore.denominazione)" />
						                <label value="@load(each.unitaProponente)" />
										<label value="@load(not empty each.propostaDelibera ? c:cat3('Oggetto', ': ',  each.propostaDelibera.oggetto) : c:cat3('Oggetto', ': ',  each.determina.oggetto))" />
									</vlayout>
								</listcell>
				                <listcell>
									<hlayout>
						                <image visible="@load(not empty each.esito)"
						                	tooltiptext="Esito Confermato"
						                	src="@load(each.confermaEsito ? '/images/agsde2/22x22/viewok.png' : '')"/>
										<label value="@load(each.esito.titolo)"/>
									</hlayout>
								</listcell>
								<listcell label="@load(each.labelDelibera)" style="color:black;" />
							</listitem>
						</template>
					</listbox>
				</hlayout>
			</vlayout>
			<!-- lato di destra: pulsanti per riordinare le proposte. -->
			<vbox pack="middle" align="center" vflex="1">
				<button image="/images/afc/22x22/up_blu.png"   onClick="@command('onSuSequenza', lista=listaProposte)"
						orient="vertical" disabled="@load(empty vm.selectedProposta or not empty vm.seduta.secondaSeduta or lista.getSelectedIndex() eq 0)"/>
				<button image="/images/afc/22x22/down_blu.png" onClick="@command('onGiuSequenza', lista=listaProposte)"
						orient="vertical" disabled="@load(empty vm.selectedProposta or not empty vm.seduta.secondaSeduta or lista.getSelectedIndex() eq vm.listaProposte.size() -1)"/>
			</vbox>
		</hlayout>
    </window>
</zk>