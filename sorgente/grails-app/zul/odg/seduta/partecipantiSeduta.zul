<?xml version="1.0" encoding="UTF-8"?>

<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window apply="grailsBindComposer" vflex="1"
		viewModel="@id('vm') @init('odgPartecipantiSedutaViewModel')">
		<hlayout hflex="1" vflex="1">
			<vlayout hflex="1" vflex="1">
				<hlayout width="100%" style="vertical-align:bottom">
					<div hflex="1">
						<button mold="trendy" image="/images/agsde2/16x16/viewok.png" label="Seleziona Tutti Presenti" onClick="@command('onSelezionaTuttiPresenti')" disabled="@load(not empty vm.seduta.secondaSeduta)"/>
						<label value=" Numero presenti: " style="color: green; margin-left: 20px;" /><label value="@load(vm.numeroPresenti)" style="color: green; font-weight: bold;" />
						<label value=" Numero assenti: " style="color: red; margin-left: 20px;" /><label value="@load(vm.numeroAssenti)" style="color: red; font-weight: bold;" />
					</div>
					<div style="text-align:right; white-space:nowrap;">
						<button mold="trendy" image="/images/agsde2/16x16/calendar_year.png" label="Seconda Convocazione" visible="@load(vm.creaSecondaConvocazione)"
							disabled="@load(not vm.abilitaCreaSecondaConvocazione)" onClick="@command('onCreaSecondaSeduta')" />
					</div>
				</hlayout>

				<label sclass="msgErrore" value="@load(vm.lbRuoliObbligatori)" />

				<listbox id="listaPresenze" model="@load(vm.listaPartecipanti)" vflex="1"
				    selectedItem="@bind(vm.selectedPartecipante)"
					emptyMessage="Nessun dato trovato">
					<listhead>
						<listheader label="" width="5%" />
						<listheader label="Cognome Nome" width="@load(vm.mostraAssentiNonGiustificati ? '15%' : '30%')" />
						<listheader label="" 	     	 width="30px" />
						<listheader label="Orario" 	     width="45px" />
						<listheader label="Ruolo" 	     width="8%" />
						<listheader label="Incarico" 	 width="15%" />
						<listheader label="Firma"		 width="5%" style="text-align: center" />
						<listheader label="Presenti" 	 width="15%" style="text-align: center" />
						<listheader label="Assenti"  	 width="15%" style="text-align: center" />
						<listheader label="Assenti non giustificati" width="15%" style="text-align: center" visible="@load(vm.mostraAssentiNonGiustificati)" />
						<listheader label="" 			 width="5%" style="text-align:center;">
							<image style="cursor: pointer;" tooltiptext="Aggiungi un partecipante"
								src="/images/afc/16x16/add.png" onClick="@command('onCreaPartecipante')"
								visible="@load(vm.seduta.secondaSeduta eq null)"></image>
						</listheader>
					</listhead>
					<template name="model" var="partecipante">
						<listitem>
							<listcell style="text-align:center;">
								<image src="/images/agsde2/22x22/annotate.png" onClick="@command('onModificaPartecipante', partecipante=partecipante)" />
							</listcell>
							<listcell label="@load(not empty partecipante.commissioneComponente ? partecipante.commissioneComponente.componente.denominazione : partecipante.componenteEsterno.denominazione )" />
							<listcell style="text-align: center">
								<image style="float:right;" src="@load(partecipante.delega ? '/images/agsde2/16x16/user.png' : '')"
								tooltiptext="@load(partecipante.delega ? c:cat('Delegato ', (not empty partecipante.sedutaPartecipanteDelegato.commissioneComponente ? partecipante.sedutaPartecipanteDelegato.commissioneComponente.componente.denominazione : partecipante.sedutaPartecipanteDelegato.componenteEsterno.denominazione )) : '')"/>
							</listcell>
							<listcell style="text-align: center">
								<image src="/images/afc/22x22/calendar.png" visible="@load(vm.dataOraPresenzaComponenti and partecipante.dataEntrata ne null)"
									   tooltiptext="@load(c:cat(partecipante.dataEntrata ne null ? c:cat3('Entrata ',c:formatDate(partecipante.dataEntrata, 'dd/MM/yyyy'),partecipante.oraEntrata ne null ? c:cat(' ',partecipante.oraEntrata):''):'' ,partecipante.dataUscita ne null ? c:cat3(' - Uscita ',c:formatDate(partecipante.dataUscita, 'dd/MM/yyyy'),partecipante.oraUscita ne null ? c:cat(' ',partecipante.oraUscita):''):'' ))" />
							</listcell>
							<listcell label="@load(partecipante.ruoloPartecipante.descrizione)" />
							<listcell label="@load(partecipante.incarico.titolo)" />
							<listcell style="text-align: center">
								<label style="float:left;" visible="@load(partecipante.firmatario)" value="@load(c:cat(partecipante.sequenzaFirma,'°'))" />
								<image style="float:right;" src="@load(partecipante.firmatario ? '/images/afc/16x16/legitimate.png' : '')" />
							</listcell>
							<!-- PRESENTE -->
							<listcell style="text-align:center;">
								<radio value="Presenti" checked="@load(partecipante.presente eq true)" onCheck="@command('onSettaPresenza', valore='Presenti', partecipante=partecipante)" />
							</listcell>
							<!-- ASSENTE -->
							<listcell style="text-align:center;">
								<radio value="Assenti"
									   checked="@load(partecipante.presente eq false and partecipante.assenteNonGiustificato eq false)" onCheck="@command('onSettaPresenza', valore='Assenti', partecipante=partecipante)" />
							</listcell>
							<!-- ASSENTE NON GIUSTIFICATO -->
							<listcell style="text-align:center;"
									  visible="@load(vm.mostraAssentiNonGiustificati)">
								<radio value="Assenti Non Giustificati"
									   checked="@load(partecipante.assenteNonGiustificato eq true and partecipante.presente eq false)" onCheck="@command('onSettaPresenza', valore='Assenti Non Giustificati', partecipante=partecipante)" />
							</listcell>
							<listcell style="text-align:center;">
								<image src="/images/agsde2/16x16/trash.png" onClick="@command('onEliminaPartecipante', partecipante=partecipante)" visible="@load(not partecipante.convocato)" />
							</listcell>
						</listitem>
					</template>
				</listbox>
			</vlayout>

			<!-- lato di destra: pulsanti per riordinare i convocati. -->
			<vbox  pack="middle" align="center" vflex="1">
				<button image="/images/afc/22x22/up_blu.png"   onClick="@command('onSuSequenza', listaPresenze=listaPresenze)"
						orient="vertical" disabled="@load(empty vm.selectedPartecipante or listaPresenze.getSelectedIndex() eq 0)"/>
				<button image="/images/afc/22x22/down_blu.png" onClick="@command('onGiuSequenza', listaPresenze=listaPresenze)"
						orient="vertical" disabled="@load(empty vm.selectedPartecipante or listaPresenze.getSelectedIndex() eq vm.listaPartecipanti.size() -1)"/>
			</vbox>
		</hlayout>
	</window>
</zk>