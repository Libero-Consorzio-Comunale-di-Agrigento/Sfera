<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?link rel="stylesheet" type="text/css" href="/css/atti.css"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:w="http://www.zkoss.org/2005/zk/client"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window apply="grailsBindComposer"
    	viewModel="@id('vm') @init('popupSceltaDestinatariPiTreViewModel')"
    	border="normal"
        width="1000px"
        sizable="true"
        title=" ">
        <vlayout>
			<h:div class="barraTitoloPagina">
				<label sclass="titoloPagina" value="Gestione Rubrica Protocollo"/>

			</h:div>

			<grid sclass="form">
				<rows>
					<row>
						<cell></cell>
						<cell></cell>
						<cell></cell>
						<cell></cell>
					</row>
					<row>
						<cell hflex="1" align="right">
							<label value="Tipo"/>
						</cell>
						<cell colspan="3">
							<radiogroup  selectedItem="@bind(vm.tipo)" onCheck="@command('onCheckUtenti')">
								<radio label="Tutti" value="@load(vm.tipoGlobal)" visible="@load(vm.visualizzaExternal)"/>
								<radio label="Interni" value="@load(vm.tipoInternal)" visible="true"/>
								<radio label="Esterni" value="@load(vm.tipoExternal)" visible="@load(vm.visualizzaExternal)"/>
							</radiogroup>
						</cell>
					</row>

					<row>
						<cell hflex="1" align="right">
							<label value="Gruppo"/>
						</cell>
							<cell colspan="1">
								<checkbox checked="@bind(vm.tipoGruppoOffices)" label="Uffici"/>
								<checkbox checked="@bind(vm.tipoGruppoRoles)" label="Ruoli"/>
								<checkbox checked="@bind(vm.tipoGruppoUsers)" label="Utenti" visible="@load(vm.visualizzaUtenti)"/>
							</cell>

							<!--radiogroup selectedIndex="@load(vm.indiceNotifica)" selectedItem="@bind(vm.tipoGruppo)" >
								<radio label="Unità" value="@load(vm.tipoGruppoOffices)" />
								<radio label="Ruoli" value="@load(vm.tipoGruppoRoles)" />
								<radio label="Persone" value="@load(vm.tipoGruppoUsers)"/>
							</radiogroup-->
					</row>
					<row>
						<cell hflex="1" align="right">
							<label value="Rubrica"/>
						</cell>
						<cell colspan="1">
							<combobox mold="rounded" hflex="1"
									  selectedItem="@bind(vm.rubrica)"
									  model="@load(vm.listaRubriche)"
							>
								<template name="model">
									<comboitem label="@load(c:cat3(each.codice,' - ',each.descrizione))" value="@load(each)"/>
								</template>
							</combobox>
						</cell>
					</row>
					<row>
						<cell align="right" valign="top" width="30%">
							<label value="Codice"/>
						</cell>
						<cell  colspan="3">
							<textbox mold="rounded" width="300px"  value="@bind(vm.codice)"  />
						</cell>
					</row>
					<row>
						<cell align="right" valign="top" width="30%">
							<label value="Destinatario"/>
						</cell>
						<cell  colspan="3">
							<textbox mold="rounded" width="300px"  value="@bind(vm.denominazione)"  />
							<button image="/images/afc/16x16/search.png" onClick="@command('onCercaSoggettoPiTre')"/>
						</cell>
					</row>

				</rows>
			</grid>
			<listbox vflex="1" height="400px" model="@load(vm.destinatariList)" selectedItem="@bind(vm.destNotifica)" emptyMessage="Nessun Destinatario trovato." >
				<listhead>
					<listheader label="denominazione"  	sort="auto(nome)" 		 width="30%"/>
					<listheader label="email" width="30%"/>
					<listheader label="indirizzo" width="20%"/>
					<listheader label="cap" width="5%"/>
					<listheader label="comune" width="10%"/>
					<listheader label="pv" width="5%"/>
				</listhead>
				<template name="model" var="each">
					<listitem>
						<listcell label="@load(c:cat3(each.nome, ' ', each.cognome) )" />
						<listcell label="@load(each.indirizzoEmail)"/>
						<listcell label="@load(each.indirizzo)"/>
						<listcell label="@load(each.cap)"/>
						<listcell label="@load(each.comune)"/>
						<listcell label="@load(each.provincia)"/>
					</listitem>
				</template>
			</listbox>
			<h:div class="barraPulsanti">
				<h:div>
					<button label="Seleziona" onClick="@command('onSalva')" mold="trendy"></button>
					<button label="Annulla" onClick="@command('onAnnulla')" mold="trendy"></button>
				</h:div>
			</h:div>
		</vlayout>
    </window>
</zk>