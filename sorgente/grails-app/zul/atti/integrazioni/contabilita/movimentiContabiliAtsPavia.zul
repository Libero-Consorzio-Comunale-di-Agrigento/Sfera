<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window apply="grailsBindComposer"
			viewModel="@id('vm') @init('movimentiContabiliAtsPaviaViewModel')" binder="@init(queueName='movimentiContabiliQueue', queueScope='desktop')"
			width="100%"
			height="100%">

		<style>
			.entrata div.z-listcell-cnt {
			color: #3c763d;
			}

			.uscita div.z-listcell-cnt {
			color: #a94442;
			}
		</style>

		<tabbox vflex="1">
			<tabs>
				<tab label="Movimenti contabilità" />
			</tabs>
			<tabpanels>
				<tabpanel>
					<listbox model="@load(vm.listaMovimenti)" emptyMessage="Nessun Movimento Contabile" vflex="1">
						<listhead>
							<listheader width="3em" label="Anno" />
							<listheader label="Conto" />
							<listheader label="Bilancio" visible="@bind(vm.attoConImpegnoSpesa)" />
							<listheader label="SottoBudget" />
							<listheader width="7em" label="Importo" visible="@bind(vm.attoConImpegnoSpesa)"/>
							<listheader width="7em" label="Importo Iniz." visible="@bind(vm.attoConVariazione or vm.attoTrovaCopertura)"/>
							<listheader width="7em" label="Variazione" visible="@bind(vm.attoConVariazione)"/>
							<listheader width="7em" label="Residuo" visible="@bind(vm.attoTrovaCopertura)"/>
							<listheader width="7em" label="Importo Proc." visible="@bind(vm.attoConVariazione or vm.attoTrovaCopertura)"/>
							<listheader label="Progetto" />
							<listheader width="20px">
								<image width="15px" src="/images/afc/16x16/add.png"
									   onClick="@command('onAggiungiMovimentoContabile')"
									   tooltiptext="Aggiungi Movimento Contabile"
									   style="cursor: pointer;"
									   visible="@load(vm.competenzaInModifica and not vm.campiProtetti.ATS_PAVIA_CAMPI_CONTABILI)" />
							</listheader>
						</listhead>
						<template name="model" var="m">
							<listitem 	onDoubleClick="@command('onModificaMovimentoContabile', idMovimentoContabile=m.id)">
								<listcell label="@load(m.annoEsercizio)"  style="text-align: center;"/>
								<listcell label="@load(m.conto)" />
								<listcell label="@load(m.bilancio)" visible="@bind(vm.attoConImpegnoSpesa)" />
								<listcell label="@load(m.sottoBudget)"  />
								<listcell label="@load(m.importo) @converter('formatedNumber', format='###,##0.00')" visible="@bind(vm.attoConImpegnoSpesa)" style="text-align: right;" />
								<listcell label="@load(m.importoIniziale) @converter('formatedNumber', format='###,##0.00')" visible="@bind(vm.attoConVariazione or vm.attoTrovaCopertura)" style="text-align: right;" />
								<listcell label="@load(m.importoVariazione) @converter('formatedNumber', format='###,##0.00')" visible="@bind(vm.attoConVariazione)" style="text-align: right;" />
								<listcell label="@load(m.importoResiduo) @converter('formatedNumber', format='###,##0.00')" visible="@bind(vm.attoTrovaCopertura)" style="text-align: right;" />
								<listcell label="@load(m.importoProvvedimento) @converter('formatedNumber', format='###,##0.00')" visible="@bind(vm.attoConVariazione or vm.attoTrovaCopertura)" style="text-align: right;" />
								<listcell label="@load(m.progetto)" />
								<listcell>
									<image src="/images/agsde2/16x16/trash.png"
										   onClick="@command('onEliminaMovimentoContabile', idMovimentoContabile=m.id)"
										   tooltiptext="Elimina Movimento Contabile"
										   style="cursor: pointer;"
										   visible="@load(vm.competenzaInModifica and not vm.campiProtetti.ATS_PAVIA_CAMPI_CONTABILI)" />
								</listcell>
							</listitem>
						</template>
					</listbox>
				</tabpanel>
			</tabpanels>
		</tabbox>
	</window>
</zk>