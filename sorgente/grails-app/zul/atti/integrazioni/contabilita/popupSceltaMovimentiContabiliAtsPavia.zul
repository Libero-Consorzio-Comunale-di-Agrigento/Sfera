<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window apply="grailsBindComposer"
			viewModel="@id('vm') @init('popupSceltaMovContAtsPaviaViewModel')"
			border="normal"
			title=" "
			closable="false"
			width="750px" vflex='1'>
		<h:div class="barraTitoloPagina">
			<label sclass="titoloPagina" value="Movimento Contabile" />
		</h:div>
		<grid sclass="form" vflex="1">
		<rows>
			<row>
				<cell width="150px"></cell>
				<cell width="40px"></cell>
				<cell></cell>
				<cell width="100px"></cell>
				<cell width="150px"></cell>

			</row>
			<row>
				<cell align="right" valign="top">
					<label sclass="mandatoryLabel" value="*"/>
					<label value="Anno" />
				</cell>
				<cell colspan="2">
					<combobox model="@load(vm.listaAnni)"
							  selectedItem="@bind(vm.annoEsercizio) @converter('it.finmatica.zkutils.PropertyConverter', property='codice')"
							  readonly="true"
							  disabled="@bind(not (vm.modificabile) or vm.campiProtetti.ATS_PAVIA_CAMPI_CONTABILI)">
						<template name="model" var="anno">
							<comboitem label="@load(anno.codice)" value="@load(anno)" />
						</template>
					</combobox>
				</cell>
			</row>
			<row>
				<cell align="right">
					<label sclass="mandatoryLabel" value="*"/>
					<label value="Conto" />
				</cell>
				<cell>
					<button style="float:right;" image="/images/agsde2/16x16/annotate.png" onClick="@command('onCercaDizionario', dizionario='CONTO'))" visible="@bind(vm.modificabile and not vm.campiProtetti.ATS_PAVIA_CAMPI_CONTABILI)"/>
				</cell>
				<cell colspan="3">
					<label value="@bind(c:cat3(vm.conto, ' - ', vm.contoDescrizione))" visible="@bind(!(vm.conto eq null))" />
				</cell>
			</row>
			<row visible="@load(vm.bilancioVisibile)">
				<cell align="right">
					<label sclass="mandatoryLabel" value="*"/>
					<label value="Bilancio" />
				</cell>
				<cell>
					<button image="/images/agsde2/16x16/annotate.png" onClick="@command('onCercaDizionario', dizionario='BILANCIO'))"  visible="@bind(vm.modificabile and not vm.campiProtetti.ATS_PAVIA_CAMPI_CONTABILI)"/>
				</cell>
				<cell colspan="3">
					<label value="@bind(c:cat3(vm.bilancio, ' - ', vm.bilancioDescrizione))" visible="@bind(!(vm.bilancio eq null))" />
				</cell>
			</row>
			<row visible="@load(vm.sottoBudgetVisibile)">
				<cell align="right">
					<label sclass="mandatoryLabel" value="*" visible="@bind(vm.sottoBudgetObbligatorio)"/>
					<label value="Sotto budget" />
				</cell>
				<cell>
					<button image="/images/agsde2/16x16/annotate.png" onClick="@command('onCercaDizionario', dizionario='SOTTOBUDGET'))" visible="@bind(vm.modificabile and vm.sottoBudgetObbligatorio)" />
				</cell>
				<cell colspan="3">
					<label value="@bind(c:cat3(vm.sottoBudget, ' - ', vm.sottoBudgetDescrizione))" visible="@bind(!(vm.sottoBudget eq null))" />
				</cell>
			</row>
			<row visible="@load(vm.importoVisibile)">
				<cell align="right">
					<label sclass="mandatoryLabel" value="*"/>
					<label value="Importo" />
				</cell>
				<cell colspan="4">
					<doublebox value="@bind(vm.importo)" format=",###.#00" constraint="no empty" disabled="@bind(not (vm.modificabile) or vm.campiProtetti.ATS_PAVIA_CAMPI_CONTABILI)"/>
				</cell>
			</row>
			<row visible="@load(vm.importoInizialeVisibile)">
				<cell align="right">
					<label sclass="mandatoryLabel" value="*"/>
					<label value="Importo iniziale" />
				</cell>
				<cell colspan="2">
					<doublebox value="@bind(vm.importoIniziale)" format=",###.#00" constraint="no empty" disabled="@bind(not (vm.modificabile) or vm.campiProtetti.ATS_PAVIA_CAMPI_CONTABILI)"/>
				</cell>

				<cell align="right" visible="@load(vm.variazioneVisibile)">
					<label sclass="mandatoryLabel" value="*"/>
					<label value="Variazione" />
				</cell>
				<cell visible="@load(vm.variazioneVisibile)">
					<doublebox value="@bind(vm.importoVariazione)" format=",###.#00" constraint="no empty" disabled="@bind(not (vm.modificabile) or vm.campiProtetti.ATS_PAVIA_CAMPI_CONTABILI)"/>
				</cell>
				<cell align="right" visible="@load(vm.importoResiduoVisibile)">
					<label sclass="mandatoryLabel" value="*"/>
					<label value="Importo residuo" />
				</cell>
				<cell visible="@load(vm.importoResiduoVisibile)">
					<doublebox value="@bind(vm.importoResiduo)" format=",###.#00" constraint="no empty" disabled="@bind(not (vm.modificabile) or vm.campiProtetti.ATS_PAVIA_CAMPI_CONTABILI)"/>
				</cell>
			</row>
			<row visible="@load(vm.importoProvvedimentoVisibile)">
				<cell align="right">
					<label sclass="mandatoryLabel" value="*"/>
					<label value="Importo finale" />
				</cell>
				<cell colspan="4">
					<doublebox value="@bind(vm.importoProvvedimento)" format=",###.#00" constraint="no empty" disabled="@bind(not (vm.modificabile) or vm.campiProtetti.ATS_PAVIA_CAMPI_CONTABILI)"/>
				</cell>
			</row>
			<row visible="@load(vm.progettoVisibile)">
				<cell align="right">
					<label sclass="mandatoryLabel" value="*"/>
					<label value="Progetto" />
				</cell>
				<cell colspan="4">
					<textbox value="@bind(vm.progetto)" hflex="1" maxlength="255" multiline="true" rows="2" focus="true" sclass="noresizable" disabled="@bind(not (vm.modificabile) or vm.campiProtetti.ATS_PAVIA_CAMPI_CONTABILI)" />
				</cell>
			</row>
			<row>
				<cell align="right">
					<label value="Note" />
				</cell>
				<cell colspan="4">
					<textbox value="@bind(vm.note)" hflex="1" maxlength="4000" multiline="true" rows="3" focus="true" sclass="noresizable" disabled="@bind(not vm.modificabile)" />
				</cell>
			</row>
		</rows>
		</grid>
		<h:div class="barraPulsanti">
			<h:div>
				<button label="Salva"   onClick="@command('onSalva')"  mold="trendy" image="/images/pulsanti/16x16/filesave.png" disabled="@bind(not vm.modificabile)" />
				<button label="Annulla" onClick="@command('onChiudi')" mold="trendy" image="/images/pulsanti/16x16/window_close.png" />
			</h:div>
		</h:div>
	</window>
</zk>