<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

  <window apply="grailsBindComposer"
       viewModel="@id('vm') @init('popupSceltaSoggettiJSerfinViewModel')"
        border="normal"
        title=" "
        closable="false"
        width="920px" height="600px">
        <h:div class="barraTitoloPagina">
            <label sclass="titoloPagina" value="Ricerca Anagrafica" />
        </h:div>
        <groupbox closable="false" vflex="1">
            <caption>Selezione</caption>
            <grid sclass="form">
                <rows>
                    <row>
                        <cell align='right' width="150px">
                            <label value="Codice Fiscale" />
                        </cell>
                        <cell>
                            <textbox value="@bind(vm.codiceFiscale)" style="text-transform: uppercase" width="180px" />
                        </cell>
                        <cell align='right' width="150px">
                            <button image="/images/afc/16x16/search.png" mold="trendy" label="Ricerca Anagrafica" onClick="@command('onRicercaAnagrafica', search=vm.codiceFiscale)"/>
                        </cell>
                    </row>
                </rows>
            </grid >
            <groupbox closable="false" vflex="1" style="background-color: #ffffff !important;">
                <listbox model="@load(vm.listaAnagrafica)" selectedItem="@bind(vm.anagraficaSelezionata)" emptyMessage="Nessuna anagrafica trovata"
                        width="100%" height="100%" checkmark="true" multiple="false"  style="overflow-x:hidden; overflow-y:auto">
                    <listhead>
                        <listheader label="" width="50px" />
                        <listheader label="Codice" width="80px" />
                        <listheader label="Nominativo" />
                        <listheader label="Partita Iva" width="100px" />
                        <listheader label="Codice fiscale" width="150px" />
                        <listheader label="Indirizzo" />
                        <listheader label="Comune" />
                    </listhead>
                    <template name="model" var="documento">
                        <listitem>
                            <listcell label=""/>
                            <listcell label="@load(documento.pkid)"/>
                            <listcell label="@load(documento.ragioneSociale eq null ? c:cat3(documento.cognome, ' ', documento.nome) : documento.ragioneSociale)" />
                            <listcell label="@load(documento.partitaIva)"/>
                            <listcell label="@load(documento.codiceFiscale)"/>
                            <listcell label="@load(c:cat3(documento.indirizzo, ' ', documento.civico))"/>
                            <listcell label="@load(c:cat3(documento.comune, ' - ', documento.provincia))"/>
                        </listitem>
                    </template>
                </listbox>
        </groupbox>
        </groupbox>



         <groupbox closable="false">
             <caption>Dettaglio Anagrafica</caption>
             <grid sclass="form">
                 <rows>
                     <row>
                         <cell width = "130px" />
                         <cell hflex = "1"/>
                         <cell width = "130px" />
                         <cell hflex = "1"/>
                         <cell width = "130px" />
                         <cell hflex = "1"/>
                     </row>
                     <row>
                         <cell align='right'>
                             <label value="@bind(vm.anagraficaSelezionata eq null ? '' : 'Codice')"/>
                         </cell>
                         <cell>
                             <label value="@bind(vm.anagraficaSelezionata.pkid)"/>
                         </cell>
                         <cell colspan="4" align='right'>
                             <button mold="trendy"
                                     label="Modifica Anagrafica"
                                     onClick="@command('onAbilitaModifica')"
                                     disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or vm.abilitaModifica)"
                                     image="/images/agsde2/16x16/pencil.png" />
                         </cell>
                     </row>
                     <row>
                         <cell align='right'>
                             <label value="Ragione sociale"/>
                         </cell>
                         <cell colspan="5">

                             <textbox value="@bind(vm.anagraficaSelezionata.ragioneSociale)" hflex="1" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))" />
                         </cell>
                     </row>
                     <row>
                         <cell align='right'>
                             <label value="Cognome"/>
                         </cell>
                         <cell>
                             <textbox value="@bind(vm.anagraficaSelezionata.cognome)" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))" hflex="1" />
                         </cell>
                         <cell align='right'>
                             <label value="Nome"/>
                         </cell>
                         <cell>
                             <textbox value="@bind(vm.anagraficaSelezionata.nome)" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))"/>
                         </cell>
<!--                         <cell align='right'>-->
<!--                             <label value="Sesso"/>-->
<!--                         </cell>-->
<!--                         <cell>-->
<!--                             <radiogroup selectedIndex="@load(vm.anagraficaSelezionata.sesso eq 'M' ? 0 : 1)" selectedItem="@save(vm.anagraficaSelezionata.sesso)">-->
<!--                                 <radio label="M" value="@load(true)" disabled="@load(vm.anagraficaSelezionata.protetta)" />-->
<!--                                 <radio label="F" value="@load(false)" disabled="@load(vm.anagraficaSelezionata.protetta)" />-->
<!--                             </radiogroup>-->
<!--                         </cell>-->
                     </row>
                     <row>
                         <cell align='right'>
                             <label value="Codice fiscale"/>
                         </cell>
                         <cell>
                             <textbox value="@bind(vm.anagraficaSelezionata.codiceFiscale)" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))" hflex="1" />
                         </cell>
                         <cell align='right'>
                             <label value="Partita Iva"/>
                         </cell>
                         <cell>
                             <textbox value="@bind(vm.anagraficaSelezionata.partitaIva)" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))" />
                         </cell>
                         <cell></cell>
                         <cell></cell>
                     </row>
                     <row>
                         <cell align='right'>
                             <label value="Indirizzo"/>
                         </cell>
                         <cell colspan="3">
                             <textbox value="@bind(vm.anagraficaSelezionata.indirizzo)" hflex="1" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))" />
                         </cell>
                         <cell align='right'>
                             <label value="Civico"/>
                         </cell>
                         <cell>
                             <textbox value="@bind(vm.anagraficaSelezionata.civico)" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))" />
                         </cell>
                     </row>
                     <row>
                         <cell align='right'>
                             <label value="Comune"/>
                         </cell>
                         <cell>
                             <textbox value="@bind(vm.anagraficaSelezionata.comune)" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))" hflex="1" />
                         </cell>
                         <cell align='right'>
                             <label value="Cap"/>
                         </cell>
                         <cell>
                             <textbox value="@bind(vm.anagraficaSelezionata.cap)" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))" />
                         </cell>
                         <cell align='right'>
                             <label value="Provincia"/>
                         </cell>
                         <cell>
                             <textbox value="@bind(vm.anagraficaSelezionata.provincia)" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))" />
                         </cell>
                     </row>
                     <row>
                         <cell align='right'>
                             <label value="Stato"/>
                         </cell>
                         <cell>
                             <textbox value="@bind(vm.anagraficaSelezionata.stato)" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))" hflex="1" />
                         </cell>
                         <cell align='right'>
                             <label value="Email"/>
                         </cell>
                         <cell>
                             <textbox value="@bind(vm.anagraficaSelezionata.email)" disabled="@bind(vm.anagraficaSelezionata.protetta or vm.anagraficaSelezionata eq null or (!(vm.abilitaModifica)))" />
                         </cell>
                     </row>
                  </rows>
              </grid >
         </groupbox>
         <space/>
         <h:div class="barraPulsanti">
            <h:div>
                <button
                    mold="trendy"
                    label="Salva"
                    onClick="@command('onSalva')"
                    image="/images/pulsanti/16x16/filesave.png" />
                <button
                    mold="trendy"
                    label="Chiudi"
                    onClick="@command('onChiudiPopup')"
                    image="/images/pulsanti/16x16/window_close.png" />
            </h:div>
        </h:div>
    </window>
</zk>