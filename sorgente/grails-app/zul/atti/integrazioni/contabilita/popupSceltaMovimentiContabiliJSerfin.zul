<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">
<!--
POPUP DI INSERIMENTO DATI CONTABILI PER INTEGRAZIONE JSERFIN
La pop-up è la stessa per tutti gli inserimenti (impegni, accertamenti,...) e sia che si apra il record in modifica, in lettura o a seguito di duplica.

In inserimento prima viene riportata la combo di scelta anagrafica con pulsante per andare in ricerca delle anagrafiche
Poi c'è un radio-button con l'operazione che si vuole fare (es creazione impegno, variazione impegno ecc..)
I valori del radio-button cambiano in base alla grid da dove si apre la pop-up. E in base alla scelta dell'operazione che si vuole fare
cambiano i contenuti della pagina.
Quindi in base alla scelta della pop-up cambia la ricerca che si vuole fare (per cercare i capitoli o gli impegni per esempio) e la grid con i risultati
Infine c'è la parte di inserimento valori con oggetto - importo - cig e cup (più v livello se non presente nel capitolo

In modifica vengono mostrati tutti i campi in sola lettura a parte importo - oggetto - cig e cup che sono gli unici modificabili
V_LIVELLO_OBBLIGATORI
In fase di duplica la maschera si comporta come la modifica a parte un campo in più relativo all'anno del movimento
-->
  <window apply="grailsBindComposer"
       viewModel="@id('vm') @init('popupSceltaMovContJSerfinViewModel')"
        border="normal"
        title=" "
        closable="false"
        width="950px" height="@bind(vm.isInserimento ? '650px' : '550px')">
        <h:div class="barraTitoloPagina">
				<label sclass="titoloPagina" value="@load(vm.labelTitolo)" />
        </h:div>
        <groupbox closable="false" visible="@load(vm.isInserimento)">
            <caption><label value="@load(vm.isRicercaAnagrafica?'Anagrafica':'Operazione')" /></caption>
            <grid sclass="form">
                <rows>
                    <row visible="@load(vm.isRicercaAnagrafica)">
                        <cell align='right'  width="150px">
                            <label value="Seleziona Anagrafica" />
                        </cell>
                        <cell>
                            <combobox model="@load(vm.listaAnagrafiche)"  hflex="1"
                                      selectedItem="@bind(vm.anagrafica) @converter('it.finmatica.zkutils.PropertyConverter', property='id')"
                                      readonly="true"
                                      disabled="@load(!vm.anagraficaAbilitata)">
                                <template name="model" var="anagrafica">
                                    <comboitem label="@load((anagrafica.ragioneSociale eq null or anagrafica.ragioneSociale eq '') ? c:cat3(anagrafica.cognome,' ',anagrafica.nome) : anagrafica.ragioneSociale)" value="@load(anagrafica)" />
                                </template>
                            </combobox>
                        </cell>
                        <cell align='right' width="150px">
                            <button image="/images/afc/16x16/search.png" mold="trendy" label="Ricerca Soggetto" onClick="@command('onRicercaAnagrafica')" disabled="@load(!vm.anagraficaAbilitata)" />
                        </cell>
                    </row>
                    <row>
                        <cell align='right' width="150px">
                            <label value="Operazione"/>
                        </cell>
                        <!-- in base alla scelta del radiobutton si abilita una sezione di ricerca diversa -->
                        <cell colspan="2">
                            <radiogroup  selectedItem="@save(vm.operazione)" onCheck="@command('onCheckOperazione')">
                                <radio label="Nuova prenotazione" value="PRENOTAZIONE" visible="@bind(vm.tipoDettaglio eq 'PRENOTAZIONE')"  disabled="@load(!vm.anagraficaAbilitata)" checked="@load(vm.operazioneScelta eq 'PRENOTAZIONE')"/>
                                <radio label="Variazione di una prenotazione" value="PRENOTAZIONE_VARIAZIONE"  visible="@load(vm.tipoDettaglio eq 'PRENOTAZIONE')" disabled="@load(!vm.anagraficaAbilitata)" checked="@load(vm.operazioneScelta eq 'PRENOTAZIONE_VARIAZIONE')"/>

                                <radio label="Nuovo impegno" value="IMPEGNO"  visible="@load(vm.tipoDettaglio eq 'IMPEGNO')" disabled="@load(!vm.anagraficaAbilitata)" checked="@load(vm.operazioneScelta eq 'IMPEGNO')"/>
                                <radio label="Impegno su prenotazione" value="IMPEGNO_PRENOTAZIONE"  visible="@load(vm.tipoDettaglio eq 'IMPEGNO')" disabled="@load(!vm.anagraficaAbilitata)" checked="@load(vm.operazioneScelta eq 'IMPEGNO_PRENOTAZIONE')"/>
                                <radio label="Variazione di un impegno" value="IMPEGNO_VARIAZIONE"  visible="@load(vm.tipoDettaglio eq 'IMPEGNO')" disabled="@load(!vm.anagraficaAbilitata)" checked="@load(vm.operazioneScelta eq 'IMPEGNO_VARIAZIONE')"/>

                                <radio label="Nuovo sub-impegno" value="SUBIMPEGNO"  visible="@load(vm.tipoDettaglio eq 'SUBIMPEGNO')" disabled="@load(!vm.anagraficaAbilitata)" checked="@load(vm.operazioneScelta eq 'SUBIMPEGNO')"/>
                                <radio label="Variazione di un sub-impegno" value="SUBIMPEGNO_VARIAZIONE"  visible="@load((vm.tipoDettaglio eq 'SUBIMPEGNO') and (vm.isAbilitataVariazioneSubImpegno))" disabled="@load(!vm.anagraficaAbilitata)" checked="@load(vm.operazioneScelta eq 'SUBIMPEGNO_VARIAZIONE')"/>

                                <radio label="Nuovo accertamento" value="ACCERTAMENTO"  visible="@load(vm.tipoDettaglio eq 'ACCERTAMENTO')" disabled="@load(!vm.anagraficaAbilitata)" checked="@load(vm.operazioneScelta eq 'ACCERTAMENTO')"/>
                                <radio label="Variazione di un accertamento" value="ACCERTAMENTO_VARIAZIONE"  visible="@load(vm.tipoDettaglio eq 'ACCERTAMENTO')" disabled="@load(!vm.anagraficaAbilitata)" checked="@load(vm.operazioneScelta eq 'ACCERTAMENTO_VARIAZIONE')"/>
                            </radiogroup>
                        </cell>
                    </row>
                </rows>
            </grid >
        </groupbox>

      <!--la sezione di ricerca prevede anno e numero come campi di ricerca sempre presenti....poi cambia la grid del risultato (a seconda del ws che si deve chiamare) -->
      <groupbox closable="false" visible="@load(vm.isInserimento)">
      <caption><label value="@load(vm.labelRicercaForm)" /></caption>
      <grid sclass="form">
          <rows>
              <row visible="false">
                  <cell width="200px"></cell>
                  <cell></cell>
                  <cell width="150px"></cell>
                  <cell></cell>
                  <cell width="150px"></cell>
                  <cell></cell>
                  <cell width="150px"></cell>
              </row>
              <row>
                  <cell align='right' width="150px">
                      <label value="@load(vm.labelRicercaNumero)" />
                  </cell>
                  <cell>
                      <textbox value="@bind(vm.numero) @converter('it.finmatica.zkutils.OnlyNumbersConverter')" width="100px" disabled="@bind(ricercaAbilitata)" />
                  </cell>
                  <cell align='right' width="150px">
                      <label value="@load(vm.labelRicercaAnno)" />
                  </cell>
                  <cell>
                      <intbox value="@bind(vm.anno)" width="50px" disabled="@bind(ricercaAbilitata)" />
                  </cell>
                  <cell align='right' visible="@bind(vm.annoCompetenzaVisibile)" width="150px">
                      <label value="@load(vm.labelAnnoEsigibilita)" />
                  </cell>
                  <cell >
                      <textbox value="@bind(vm.annoCompetenza)" width="50px" visible="@bind(vm.annoCompetenzaVisibile)" disabled="@bind(ricercaAbilitata)" />
                  </cell>
                  <cell align='right' width="150px">
                      <button image="/images/afc/16x16/search.png" mold="trendy" disabled="@bind(ricercaAbilitata)" label="Cerca" onClick="@command('onRicerca', numero=vm.numero, anno = vm.anno, codiceLavoro=vm.codiceLavoro)"/>
                  </cell>
              </row>
              <row visible="@bind(vm.isRicercaCapitoliCodiceLavoro or vm.visCodiceGlobale)">
                  <cell align='right' width="150px" visible="@bind(vm.isRicercaCapitoliCodiceLavoro)">
                      <label value="Codice Lavoro" />
                  </cell>
                  <cell visible="@load(vm.isRicercaCapitoliCodiceLavoro)">
                      <textbox value="@bind(vm.codiceLavoro) @converter('it.finmatica.zkutils.OnlyNumbersConverter')" width="100px" disabled="@bind(ricercaAbilitata)" />
                  </cell>
                  <cell align='right' width="150px" visible="@bind(vm.visCodiceGlobale)">
                      <label value="Codice Globale" />
                  </cell>
                  <cell colspan="4" visible="@bind(vm.visCodiceGlobale)">
                      <textbox value="@bind(vm.codiceGlobale) @converter('it.finmatica.zkutils.OnlyNumbersConverter')" width="100px" disabled="@bind(ricercaAbilitata)" />
                  </cell>
              </row>
          </rows>
      </grid >
      </groupbox>

      <!-- GRID SCELTA CAPITOLI -->
      <groupbox closable="false" height="200px" style="background-color: #ffffff !important;" visible="@bind(vm.visElencoCapitoli)">
          <listbox model="@load(vm.listaContabile)" emptyMessage="@bind(vm.labelRicercaEmptyMessage)" selectedItem="@bind(vm.movimentoSelezionato)"
                   width="100%" height="190px" checkmark="true" multiple="false"  style="overflow-x:none; overflow-y:auto">
              <listhead>
                  <listheader label="" width="25px" />
                  <listheader label="Capitolo" width="80px" />
                  <listheader label="Descrizione" hflex="1" />
                  <listheader label="Anno" width="50px" />
                  <listheader label="Disponibilità" width="80px" />
                  <listheader label="U/E" width="25px" />
                  <listheader label="Descrizione Budget" hflex="2" />
              </listhead>
              <template name="model" var="documento">
                  <listitem>
                      <listcell label=""/>
                      <listcell label="@load(documento.numcapitolo)" />
                      <listcell label="@load(documento.descrizione)" tooltiptext="@load(documento.descrizione)"/>
                      <listcell label="@load(documento.annocompetenza)"/>
                      <listcell label="@load(documento.disponibile) @converter('formatedNumber', format='###,##0.00')"/>
                      <listcell label="@load(documento.parte)"/>
                      <listcell><label value="@load(documento.descrizionebudget)" multiline="true" tooltiptext="@load(documento.descrizionebudget)" /></listcell>
                      <listcell />
                  </listitem>
              </template>
          </listbox>
      </groupbox>

      <!-- GRID SCELTA PRENOTAZIONE -->
      <groupbox closable="false" height="200px" style="background-color: #ffffff !important;" visible="@bind(vm.visElencoPrenotazioni)">
          <listbox model="@load(vm.listaContabile)" emptyMessage="@load(vm.labelRicercaEmptyMessage)" selectedItem="@bind(vm.movimentoSelezionato)"
                   width="100%" height="190px" checkmark="true" multiple="false"  style="overflow-x:hidden; overflow-y:auto">
              <listhead>
                  <listheader label="" width="30px" />
                  <listheader label="Prenotazione" width="100px" />
                  <listheader label="Anno" width="50px" />
                  <listheader label="Descrizione" hflex="1" />
                  <listheader label="U/E" width="30px" />
                  <listheader label="Capitolo" width="120px" />
                  <listheader label="Descrizione capitolo" hflex="1" />
                  <listheader label="Disponibilità" width="100px" />
              </listhead>
              <template name="model" var="documento">
                  <listitem>
                      <listcell label=""/>
                      <listcell label="@load(documento.codannuale)"/>
                      <listcell label="@load(documento.anno)"/>
                      <listcell label="@load(documento.descrizione)" tooltiptext="@load(documento.descrizione)"/>
                      <listcell label="@load(documento.parte)"/>
                      <listcell label="@load(documento.numcapitolo)" tooltiptext="@load(documento.numcapitolo)"/>
                      <listcell label="@load(documento.descapitolo)" tooltiptext="@load(documento.descapitolo)"/>
                      <listcell label="@load(documento.disponibile) @converter('formatedNumber', format='###,##0.00')"/>
                      <listcell />
                  </listitem>
              </template>
          </listbox>
      </groupbox>

      <!-- GRID SCELTA IMPEGNO -->
      <groupbox closable="false" height="200px" style="background-color: #ffffff !important;" visible="@bind(vm.visElencoImpegni)">
          <listbox model="@load(vm.listaContabile)" emptyMessage="@load(vm.labelRicercaEmptyMessage)" selectedItem="@bind(vm.movimentoSelezionato)"
                   width="100%" height="190px" checkmark="true" multiple="false"  style="overflow-x:hidden; overflow-y:auto">
              <listhead>
                  <listheader label="" width="30px" />
                  <listheader label="Codice" width="100px" />
                  <listheader label="Anno" width="50px" />
                  <listheader label="Descrizione" hflex="1" />
                  <listheader label="U/E" width="30px" />
                  <listheader label="Capitolo" width="100px" />
                  <listheader label="Descrizione capitolo" hflex="1" />
                  <listheader label="Impegnato" width="100px" />
                  <listheader label="Disponibilità" width="100px" />
              </listhead>
              <template name="model" var="documento">
                  <listitem>
                      <listcell label=""/>
                      <listcell label="@load(documento.codannuale)"/>
                      <listcell label="@load(documento.anno)"/>
                      <listcell label="@load(documento.descrizione)" tooltiptext="@load(documento.descrizione)"/>
                      <listcell label="@load(documento.parte)"/>
                      <listcell label="@load(documento.numcapitolo)" tooltiptext="@load(documento.numcapitolo)"/>
                      <listcell label="@load(documento.descapitolo)" tooltiptext="@load(documento.descapitolo)"/>
                      <listcell label="@load(documento.impegnato) @converter('formatedNumber', format='###,##0.00')"/>
                      <listcell label="@load(documento.disponibile) @converter('formatedNumber', format='###,##0.00')"/>
                      <listcell />
                  </listitem>
              </template>
          </listbox>
      </groupbox>

      <!-- GRID SCELTA SUB-IMPEGNO -->
      <groupbox closable="false" height="200px" style="background-color: #ffffff !important;" visible="@bind(vm.visElencoSubImpegni)">
          <listbox model="@load(vm.listaContabile)" emptyMessage="@load(vm.labelRicercaEmptyMessage)" selectedItem="@bind(vm.movimentoSelezionato)"
                   width="100%" height="190px" checkmark="true" multiple="false"  style="overflow-x:hidden; overflow-y:auto">
              <listhead>
                  <listheader label="" width="30px" />
                  <listheader label="Codice" width="100px" />
                  <listheader label="Anno" width="50px" />
                  <listheader label="Descrizione" hflex="1" />
                  <listheader label="U/E" width="30px" />
                  <listheader label="Capitolo" width="100px" />
                  <listheader label="Descrizione capitolo" hflex="1" />
                  <listheader label="Impegnato" width="100px" />
                  <listheader label="Disponibilità" width="100px" />
              </listhead>
              <template name="model" var="documento">
                  <listitem>
                      <listcell label=""/>
                      <listcell label="@load(documento.codannuale)"/>
                      <listcell label="@load(documento.anno)"/>
                      <listcell label="@load(documento.descrizione)" tooltiptext="@load(documento.descrizione)"/>
                      <listcell label="@load(documento.parte)"/>
                      <listcell label="@load(documento.numcapitolo)" tooltiptext="@load(documento.numcapitolo)"/>
                      <listcell label="@load(documento.descapitolo)" tooltiptext="@load(documento.descapitolo)"/>
                      <listcell label="@load(documento.impegnato) @converter('formatedNumber', format='###,##0.00')"/>
                      <listcell label="@load(documento.disponibile) @converter('formatedNumber', format='###,##0.00')"/>
                      <listcell />
                  </listitem>
              </template>
          </listbox>
      </groupbox>

      <!-- GRID SCELTA ACCERTAMENTO -->
      <groupbox closable="false" height="200px" style="background-color: #ffffff !important;" visible="@bind(vm.visElencoAccertamenti)">
          <listbox model="@load(vm.listaContabile)" emptyMessage="@load(vm.labelRicercaEmptyMessage)" selectedItem="@bind(vm.movimentoSelezionato)"
                   width="100%" height="190px" checkmark="true" multiple="false"  style="overflow-x:hidden; overflow-y:auto">
              <listhead>
                  <listheader label="" width="30px" />
                  <listheader label="Codice" width="100px" />
                  <listheader label="Anno" width="50px" />
                  <listheader label="Descrizione" hflex="1" />
                  <listheader label="U/E" width="30px" />
                  <listheader label="Capitolo" width="100px" />
                  <listheader label="Descrizione capitolo" hflex="1" />
                  <listheader label="Impegnato" width="100px" />
                  <listheader label="Disponibilità" width="100px" />
              </listhead>
              <template name="model" var="documento">
                  <listitem>
                      <listcell label=""/>
                      <listcell label="@load(documento.codannuale)"/>
                      <listcell label="@load(documento.anno)"/>
                      <listcell label="@load(documento.descrizione)" tooltiptext="@load(documento.descrizione)"/>
                      <listcell label="@load(documento.parte)"/>
                      <listcell label="@load(documento.numcapitolo)" tooltiptext="@load(documento.numcapitolo)"/>
                      <listcell label="@load(documento.descapitolo)" tooltiptext="@load(documento.descapitolo)"/>
                      <listcell label="@load(documento.impegnato) @converter('formatedNumber', format='###,##0.00')"/>
                      <listcell label="@load(documento.disponibile) @converter('formatedNumber', format='###,##0.00')"/>
                      <listcell />
                  </listitem>
              </template>
          </listbox>
      </groupbox>
         <groupbox closable="false" vflex="1">
             <caption>Dettaglio Movimento</caption>
             <grid sclass="form" vflex="1">
                 <rows>
                     <row>
                         <cell width="100px"></cell>
                         <cell></cell>
                         <cell width="150px"></cell>
                         <cell></cell>
                     </row>

<!-- se NON sono in modifica vedo i campi in sola lettura (per il momento non si possono modificare i dati inseriti) -->
                     <row visible="@load(!vm.isInserimento)">
                         <cell align='right'><label value="Operazione scelta" /></cell>
                         <cell colspan="3">
                             <radiogroup  selectedItem="@load(vm.operazioneScelta)">
                                 <radio label="Nuova prenotazione" value="PRENOTAZIONE" visible="@bind(vm.tipoDettaglio eq 'PRENOTAZIONE')"  disabled="true"/>
                                 <radio label="Variazione di una prenotazione" value="PRENOTAZIONE_VARIAZIONE"  visible="@load(vm.tipoDettaglio eq 'PRENOTAZIONE')" disabled="true"/>

                                 <radio label="Nuovo impegno" value="IMPEGNO"  visible="@load(vm.tipoDettaglio eq 'IMPEGNO')" disabled="true"/>
                                 <radio label="Impegno su prenotazione" value="IMPEGNO_PRENOTAZIONE"  visible="@load(vm.tipoDettaglio eq 'IMPEGNO')" disabled="true"/>
                                 <radio label="Variazione di un impegno" value="IMPEGNO_VARIAZIONE"  visible="@load(vm.tipoDettaglio eq 'IMPEGNO')" disabled="true"/>

                                 <radio label="Nuovo sub-impegno" value="SUBIMPEGNO"  visible="@load(vm.tipoDettaglio eq 'SUBIMPEGNO')" disabled="true"/>
                                 <radio label="Variazione di un sub-impegno" value="SUBIMPEGNO_VARIAZIONE"  visible="@load((vm.tipoDettaglio eq 'SUBIMPEGNO') and (vm.isAbilitataVariazioneSubImpegno))" disabled="true"/>

                                 <radio label="Nuovo accertamento" value="ACCERTAMENTO"  visible="@load(vm.tipoDettaglio eq 'ACCERTAMENTO')" disabled="true"/>
                                 <radio label="Variazione di un accertamento" value="ACCERTAMENTO_VARIAZIONE"  visible="@load(vm.tipoDettaglio eq 'ACCERTAMENTO')" disabled="true"/>
                             </radiogroup>
                         </cell>
                     </row>
                     <row visible="@load(!vm.isInserimento)">
                         <cell align='right'>
                             <label value="Prenotazione" visible="@load(vm.operazioneScelta eq 'PRENOTAZIONE')"/>
                             <label value="Variazione Prenotazione" visible="@load(vm.operazioneScelta eq 'PRENOTAZIONE_VARIAZIONE')"/>
                             <label value="Impegno" visible="@load(vm.operazioneScelta eq 'IMPEGNO')" />
                             <label value="Prenotazione Impegno" visible="@load(vm.operazioneScelta eq 'IMPEGNO_PRENOTAZIONE')" />
                             <label value="Variazione Impegno" visible="@load(vm.operazioneScelta eq 'IMPEGNO_VARIAZIONE')" />
                             <label value="Sub-Impegno" visible="@load(vm.operazioneScelta eq 'SUBIMPEGNO')" />
                             <label value="Variazione Sub-Impegno" visible="@load(vm.operazioneScelta eq 'SUBIMPEGNO_VARIAZIONE')" />
                             <label value="Accertamento" visible="@load(vm.operazioneScelta eq 'ACCERTAMENTO')" />
                             <label value="Variazione Accertamento" visible="@load(vm.operazioneScelta eq 'ACCERTAMENTO_VARIAZIONE')" />
                         </cell>
                         <cell><label value="@load(c:cat3(vm.annoEsercizio,' / ', vm.progressivoEsterno))"/></cell>
                         <cell align='right'>
                             <label value="Impegno originario" visible="@load(vm.operazioneScelta eq 'IMPEGNO_VARIAZIONE')"/>
                             <label value="Accertamento originario" visible="@load(vm.operazioneScelta eq 'ACCERTAMENTO_VARIAZIONE')"/>
                             <label value="Prenotazione" visible="@load(vm.operazioneScelta eq 'IMPEGNO_PRENOTAZIONE')"/>
                             <label value="Prenotazione originaria" visible="@load(vm.operazioneScelta eq 'PRENOTAZIONE_VARIAZIONE')"/>
                             <label value="Impegno" visible="@load(vm.operazioneScelta eq 'SUBIMPEGNO')"/>
                         </cell>
                         <cell>
                             <label value="@load(c:cat3(vm.annoEsercizio,' / ', vm.movimentoPadre))" visible="@load((vm.operazioneScelta eq 'IMPEGNO_VARIAZIONE') or (vm.operazioneScelta eq 'PRENOTAZIONE_VARIAZIONE') or (vm.operazioneScelta eq 'ACCERTAMENTO_VARIAZIONE'))"/>
                             <label value="@load(c:cat3(vm.annoEsercizio,' / ', vm.numeroProgrammazione))" visible="@load(vm.operazioneScelta eq 'IMPEGNO_PRENOTAZIONE')"/>
                             <label value="@load(c:cat3(vm.annoEsercizio,' / ', vm.numeroImpegnoPadre))" visible="@load(vm.operazioneScelta eq 'SUBIMPEGNO')"/>
                         </cell>
                     </row>
                     <row visible="@load(!(vm.isInserimento or (!(vm.anagraficaAbilitata))))">
                         <cell align='right'>
                             <label value="Anagrafica" />
                         </cell>
                         <cell><label value="Movimento contabile senza anagrafica" visible="@load(vm.anagrafica.id eq null)" /><label value="@load(vm.anagrafica.ragioneSociale eq null ? c:cat3(vm.anagrafica.cognome,' ', vm.anagrafica.nome) : vm.anagrafica.ragioneSociale)" visible="@load(not(vm.anagrafica.id eq null))"/></cell>
                         <cell align='right'><label value="@load(vm.anagrafica.idApplicativoEsterno eq null ? '' : 'Codice Anagrafica')" /></cell>
                         <cell><label value="@load(vm.anagrafica.idApplicativoEsterno eq null ? '' : vm.anagrafica.idApplicativoEsterno)" /></cell>
                     </row>
                     <row visible="@load(!(vm.isInserimento or (!(vm.isRicercaMovimentiCodiceGlobale)) or (vm.codiceGlobale eq null)))">
                         <cell align='right'>
                             <label value="Codice Globale" />
                         </cell>
                         <cell><label value="@load(vm.codiceGlobale)" /></cell>
                     </row>
                     <row visible="@load(!(vm.isInserimento or (!(vm.visualizzaTipoFinanziamento)) or (vm.codiceTipoFinanziamento eq null)))">
                         <cell align='right'>
                             <label value="Tipo di Finanziamento" />
                         </cell>
                         <cell colspan="3"><label value="@load(c:cat3(vm.codiceTipoFinanziamento,' - ', vm.tipoFinanziamento))" /></cell>
                     </row>
                     <row visible="@load(!vm.isInserimento)">
                         <cell align='right'>
                             <!-- cambia l'etichetta in base al tipo di dettaglio che sto aprendo
                             <label value="Capitolo" visible="@load(((vm.tipoDettaglio eq 'PRENOTAZIONE') and (vm.operazioneScelta eq 'PRENOTAZIONE'))
                                                                   or (vm.tipoDettaglio eq 'IMPEGNO') and (vm.operazioneScelta eq 'IMPEGNO'))
                                                                   or (vm.tipoDettaglio eq 'SUBIMPEGNO') and (vm.operazioneScelta eq 'SUBIMPEGNO'))
                                                                   or (vm.tipoDettaglio eq 'ACCERTAMENTO') and (vm.operazioneScelta eq 'ACCERTAMENTO'))"/>
                             <label value="Prenotazione" visible="@load((vm.tipoDettaglio eq 'PRENOTAZIONE') and (vm.operazioneScelta eq 'PRENOTAZIONE_VARIAZIONE'))
                                                                       or (vm.tipoDettaglio eq 'IMPEGNO') and (vm.operazioneScelta eq 'IMPEGNO_PRENOTAZIONE'))"/>
                             <label value="Impegno" visible="@load((vm.tipoDettaglio eq 'IMPEGNO') and (vm.operazioneScelta eq 'IMPEGNO_VARIAZIONE'))"/>
                             <label value="Sub-Impegno" visible="@load((vm.tipoDettaglio eq 'SUBIMPEGNO') and (vm.operazioneScelta eq 'SUBIMPEGNO_VARIAZIONE'))"/>
                             <label value="Accertamento" visible="@load((vm.tipoDettaglio eq 'ACCERTAMENTO') and (vm.operazioneScelta eq 'ACCERTAMENTO_VARIAZIONE'))"/>
                             -->
                             <label value="Capitolo" />
                             <label value="@load(c:cat3(' (', vm.parte, ')'))"/></cell>
                         <cell colspan="3"><label value="@load(c:cat3(vm.anno,' / ', vm.numero))"/><label value=" - "/><label value="@load(vm.descrizioneCapitolo)"/></cell>
                     </row>
                     <row visible="@load(!vm.isInserimento)">
                         <cell align='right'><label value="Descrizione"/></cell>
                         <cell colspan="3"><label value="@load(vm.descrizioneFinanziamento1)" multiline="true"/></cell>
                     </row>
<!-- LA DUPLICA PER IL MOMENTO E' DISABILITATA -->
<!--                     <row visible="@load(vm.visDuplica)">-->
<!--                         <cell align='right'>-->
<!--                             <label value="Anno Esigibilità"/>-->
<!--                         </cell>-->
<!--                         <cell colspan="3">-->
<!--                             <textbox value="@bind(vm.anno)" />-->
<!--                         </cell>-->
<!--                     </row>-->
                     <row>
                         <cell align='right'>
                             <h:span class="mandatoryLabel">*</h:span>
                             <label value="Oggetto"/><space width="5px" />
                             <button image="/images/agsde2/16x16/annotate.png"
                                     visible="@bind(vm.modificabile)"
                                     onClick="@command('onInserimentoOggetto')" />
                         </cell>
                         <cell colspan="3">
                             <textbox value="@bind(vm.oggetto)" hflex="1" maxlength="100" multiline="true" rows="3" focus="true" style="text-transform: uppercase" sclass="noresizable"  disabled="@bind(((vm.movimentoSelezionato.idcapitolo eq null) and (modifica)) or (!(vm.modificabile)))" />
                         </cell>
                     </row>
                     <row>
                         <cell align='right'>
                             <label value="Importo"/>
                         </cell>
                         <cell>
                             <decimalbox value="@bind(vm.importo)" disabled="@bind(((vm.movimentoSelezionato.idcapitolo eq null) and (modifica)) or (!(vm.modificabile)))"
                                         format="#,##0.00" locale="it" constraint="@bind(vm.importiNegativi ? 'no empty' : 'no empty,no negative')" />
                         </cell>
                         <!-- V livello visibile in modifica -->
                         <cell align='right' visible="@bind(vm.visElencoCapitoli)">
                             <h:span class="mandatoryLabel" visible="@bind(vm.movimentoSelezionato.vLivelloObbligatorio)">*</h:span>
                             <label value="@load(c:l('label.movimentoContabile.JSerfin.VLivello'))"/>
                         </cell>
                         <cell visible="@bind((vm.visElencoCapitoli or modifica) and (vm.movimentoSelezionato.lista_piani_fin_collegati.size() > 0))">
                             <combobox model="@bind(vm.movimentoSelezionato.lista_piani_fin_collegati)" hflex="1" selectedItem="@bind(vm.vLivello) @converter('it.finmatica.zkutils.PropertyConverter', defaultValue=-1)">
                                 <template name="model" var="vliv">
                                     <comboitem label="@bind(c:cat3(vliv.sigla,' - ', vliv.descrizione))" value="@bind(vliv)" />
                                 </template>
                             </combobox>
                         </cell>
                         <cell visible="@bind((vm.visElencoCapitoli or modifica) and (!(vm.movimentoSelezionato.lista_piani_fin_collegati.size() > 0)))">
                             <label value="@bind(c:cat3(vm.movimentoSelezionato.vLivello.sigla,' - ', vm.movimentoSelezionato.vLivello.descrizione))" visible="@bind(!(vm.movimentoSelezionato.vLivello eq null))"/>
                             <label value="@bind(c:cat3(vm.movimentoSelezionato.sigpianofin,' - ',vm.movimentoSelezionato.despianofin))"  visible="@bind(!(vm.movimentoSelezionato.sigpianofin eq null))" />
                         </cell>
                         <!-- V livello visibile in lettura -->
                         <cell align='right' visible="@load((!(vm.vLivello.sigla eq null)) and (!vm.isInserimento))">
                             <label value="@load(c:l('label.movimentoContabile.JSerfin.VLivello'))"/>
                         </cell>
                         <cell visible="@load(!(vm.vLivello.sigla eq null) and (!vm.isInserimento))">
                             <label value="@load(c:cat3(vm.vLivello.sigla,' - ', vm.vLivello.descrizione))"/>
                         </cell>
                     </row>
                     <row>
                         <cell align='right'>
                             <label value="Cig"/>
                         </cell>
                         <cell>
                            <textbox value="@bind(vm.cig)" width="100px" maxlength="10" disabled="@bind(((vm.movimentoSelezionato.idcapitolo eq null) and (modifica)) or (!(vm.modificabile)))" />
                         </cell>
                         <cell align='right'>
                             <label value="Cup"/>
                         </cell>
                         <cell>
                            <textbox value="@bind(vm.cup)" width="100px" maxlength="15" disabled="@bind(((vm.movimentoSelezionato.idcapitolo eq null) and (modifica)) or (!(vm.modificabile)))" />
                         </cell>
                     </row>
                  </rows>
              </grid >
        </groupbox>
        <space/>
        <h:div class="barraPulsanti">
          <h:div>
<!--              <button-->
<!--                      mold="trendy"-->
<!--                      label="Duplica"-->
<!--                      onClick="@command('onDuplica')"-->
<!--                      visible="@load(vm.visPulsanteDuplica and vm.modificabile)"-->
<!--                      image="/images/afc/16x16/house_plan.png" />-->
              <button
                      mold="trendy"
                      label="Salva"
                      onClick="@command('onSalva')"
                      image="/images/pulsanti/16x16/filesave.png"
                      visible="@bind(vm.modificabile)"
                      disabled="@bind((vm.movimentoSelezionato.idcapitolo eq null) and (modifica))"/>
              <button
                      mold="trendy"
                      label="Chiudi"
                      onClick="@command('onChiudiPopup')"
                      image="/images/pulsanti/16x16/window_close.png" />
          </h:div>
        </h:div>
    </window>
</zk>