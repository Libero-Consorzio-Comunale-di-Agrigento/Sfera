<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window apply="grailsBindComposer"
		viewModel="@id('vm') @init('movimentiContabiliJSerfinViewModel')" binder="@init(queueName='movimentiContabiliQueue', queueScope='desktop')"
		width="100%"
		height="100%">
		<style>
			.entrata div.z-listcell-cnt {
				color: #3c763d;
			}

			.uscita div.z-listcell-cnt {
				color: #a94442;
			}
		</style>

		<tabbox vflex="1">
			<tabs>
				<tab label="@load(vm.numeroImpegni > 0 ? c:cat3('Impegni (' , vm.numeroImpegni , ')') : 'Impegni')" image="@load(vm.numeroImpegni > 0 ? '/images/agsde2/16x16/info.png' : '')"/>
				<tab label="@load(vm.numeroAccertamenti > 0 ? c:cat3('Accertamenti (' , vm.numeroAccertamenti , ')') : 'Accertamenti')" image="@load(vm.numeroAccertamenti > 0 ? '/images/agsde2/16x16/info.png' : '')"/>
				<tab label="@load(vm.numeroPrenotazioni > 0 ? c:cat3('Prenotazioni (' , vm.numeroPrenotazioni , ')') : 'Prenotazioni')" image="@load(vm.numeroPrenotazioni > 0 ? '/images/agsde2/16x16/info.png' : '')"/>
				<tab label="@load(vm.numeroSubImpegni > 0 ? c:cat3('Sub-impegni (' , vm.numeroSubImpegni , ')') : 'Sub-impegni')" image="@load(vm.numeroSubImpegni > 0 ? '/images/agsde2/16x16/info.png' : '')"/>
			</tabs>
			<tabpanels>
				<!-- impegni -->
				<tabpanel>
					<grid sclass="form" visible="@load(vm.visualizzaTotali)">
						<rows>
							<row>
								<cell width="110px">Totale impegni:</cell>
								<cell>
									<label value="@load(empty vm.totaleImpegni ? 0:vm.totaleImpegni)  @converter('formatedNumber', format='###,##0.00')"/> €
								</cell>
								<cell width="170px">Totale variazione impegni:</cell>
								<cell>
									<label value="@load(empty vm.totaleImpegniVariazioni ? 0:vm.totaleImpegniVariazioni)  @converter('formatedNumber', format='###,##0.00')"/> €
								</cell>
								<cell width="170px">Totale impegni su prenotazione:</cell>
								<cell>
									<label value="@load(empty vm.totaleImpegniPrenotazioni ? 0:vm.totaleImpegniPrenotazioni)  @converter('formatedNumber', format='###,##0.00')"/> €
								</cell>
							</row>
						</rows>
					</grid>
					<listbox model="@bind(vm.listaMovimenti)" emptyMessage="Nessuna Impegno Contabile" vflex="1">
						<listhead>
							<listheader label="Impegno"	width="110px" />
							<listheader label="Var." width="30px" />
							<listheader label="Codice globale"	width="90px" visible="@load(vm.visualizzaCodiceGlobale)" />
							<listheader label="Num. Capitolo"	width="90px" />
							<listheader label="Capitolo"	width="40%" />
							<listheader label="Importo"	width="70px" />
							<listheader label="Descrizione"	width="30%" />
							<listheader label="Beneficiario" width="30%" visible="@load(vm.isRicercaAnagrafica)" />
							<listheader label="" width="40px" align="center">
								<image width="15px" src="/images/afc/16x16/add.png"
									   onClick="@command('onAggiungiMovimentoContabile', tipologia='IMPEGNO')"
									   visible="@load(vm.competenzaInModifica and not vm.campiProtetti.CONTABILITA)"
									   tooltiptext="Aggiungi Impegno"
									   style="cursor: pointer;"
								/>
							</listheader>
						</listhead>
						<template name="model" var="c">
							<listitem onDoubleClick="@command('onModificaMovimento', movimento = c.id)" visible="@load(c.tipoDettaglio eq 'IMPEGNO')">
								<listcell>
									<label value="@bind(c:cat3(c.annoEsercizio,' / ', c.progressivoEsterno))"/>
									<h:br />
									<label value="Imp. originario: "  visible="@load(c.opera eq 'IMPEGNO_VARIAZIONE')" style="font-weight: bold;"/>
									<label value="@bind(c:cat3(c.annoEsercizio,' / ', c.numeroVariazione))" visible="@load(c.opera eq 'IMPEGNO_VARIAZIONE')" style="font-weight: bold;"/>
									<label value="Prenotazione: "  visible="@load(c.opera eq 'IMPEGNO_PRENOTAZIONE')" style="font-weight: bold;"/>
									<label value="@bind(c:cat3(c.annoEsercizio,' / ', c.numeroProgrammazione))" visible="@load(c.opera eq 'IMPEGNO_PRENOTAZIONE')" style="font-weight: bold;"/>
								</listcell>
								<listcell>
									<image src="/images/agsde2/16x16/viewok.png"
												 tooltiptext="Variazione di impegno"
												 visible="@load(c.opera eq 'IMPEGNO_VARIAZIONE')" />
								</listcell>
								<listcell visible="@load(vm.visualizzaCodiceGlobale)"><label value="@load(c.codiceGlobale)"/></listcell>
								<listcell><label value="@load(c.numero)"/></listcell>
								<listcell><label value="@load(c.descrizioneCapitolo)"/></listcell>
								<listcell><label value="@load(c.importo) @converter('formatedNumber', format='###,##0.00')"/></listcell>
								<listcell><label value="@load(c.descrizione)"/></listcell>
								<listcell><label value="@load(c.ragioneSociale eq null ? c:cat3(c.cognome, ' ', c.nome) : c.ragioneSociale)"/></listcell>
								<listcell>
									<image src="/images/agsde2/16x16/trash.png"
										   onClick="@command('onEliminaMovimento', idMovimentoContabile=c.id)"
										   tooltiptext="Elimina movimento"
										   visible="@load(vm.competenzaInModifica and not vm.campiProtetti.CONTABILITA)"
										   style="cursor: pointer;" />
								</listcell>
							</listitem>
						</template>
					</listbox>
				</tabpanel>

				<!-- accertamenti -->
				<tabpanel>
					<grid sclass="form" visible="@load(vm.visualizzaTotali)">
						<rows>
							<row>
								<cell width="110px">Totale accertamenti:</cell>
								<cell>
									<label value="@load(empty vm.totaleAccertamenti ? 0:vm.totaleAccertamenti )  @converter('formatedNumber', format='###,##0.00')"/> €
								</cell>
								<cell width="170px">Totale variazione accertamenti:</cell>
								<cell>
									<label value="@load(empty vm.totaleAccertamentiVariazioni ? 0:vm.totaleAccertamentiVariazioni )  @converter('formatedNumber', format='###,##0.00')"/> €
								</cell>
							</row>
						</rows>
					</grid>
					<listbox model="@bind(vm.listaMovimenti)" emptyMessage="Nessun Accertamento" vflex="1">
						<listhead>
							<listheader label="Accertamento"	width="110px" />
							<listheader label="Var." width="30px" />
							<listheader label="Codice globale"	width="90px" visible="@load(vm.visualizzaCodiceGlobale)" />
							<listheader label="Num. Capitolo"	width="90px" />
							<listheader label="Capitolo"	width="40%" />
							<listheader label="Importo"	width="70px" />
							<listheader label="Descrizione"	width="30%" />
							<listheader label="Beneficiario" width="30%" visible="@load(vm.isRicercaAnagrafica)" />
							<listheader label="" width="40px" align="center">
								<image width="15px" src="/images/afc/16x16/add.png"
									   onClick="@command('onAggiungiMovimentoContabile', tipologia='ACCERTAMENTO')"
									   visible="@load(vm.competenzaInModifica and not vm.campiProtetti.CONTABILITA)"
									   tooltiptext="Aggiungi Movimento"
									   style="cursor: pointer;"
								/>
							</listheader>
						</listhead>
						<template name="model" var="c">
							<listitem onDoubleClick="@command('onModificaMovimento', movimento = c.id)" visible="@load(c.tipoDettaglio eq 'ACCERTAMENTO')">
								<listcell>
									<label value="@bind(c:cat3(c.annoEsercizio,' / ', c.progressivoEsterno))"/>
									<h:br />
									<label value="Accert. originario: "  visible="@load(c.opera eq 'ACCERTAMENTO_VARIAZIONE')" style="font-weight: bold;" />
									<label value="@bind(c:cat3(c.annoEsercizio,' / ', c.numeroVariazione))" visible="@load(c.opera eq 'ACCERTAMENTO_VARIAZIONE')" style="font-weight: bold;" />
								</listcell>
								<listcell><image src="/images/agsde2/16x16/viewok.png"
												 tooltiptext="Variazione di accertamento"
												 visible="@load(c.opera eq 'ACCERTAMENTO_VARIAZIONE')" /></listcell>
								<listcell visible="@load(vm.visualizzaCodiceGlobale)"><label value="@load(c.codiceGlobale)"/></listcell>
								<listcell><label value="@load(c.numero)"/></listcell>
								<listcell><label value="@load(c.descrizioneCapitolo)"/></listcell>
								<listcell><label value="@load(c.importo) @converter('formatedNumber', format='###,##0.00')"/></listcell>
								<listcell><label value="@load(c.descrizione)"/></listcell>
								<listcell><label value="@load(c.ragioneSociale eq null ? c:cat3(c.cognome, ' ', c.nome) : c.ragioneSociale)"/></listcell>
								<listcell>
									<image src="/images/agsde2/16x16/trash.png"
										   onClick="@command('onEliminaMovimento', idMovimentoContabile=c.id)"
										   tooltiptext="Elimina movimento"
										   visible="@load(vm.competenzaInModifica and not vm.campiProtetti.CONTABILITA)"
										   style="cursor: pointer;" />
								</listcell>
							</listitem>
						</template>
					</listbox>
				</tabpanel>

			<!-- Prenotazioni -->
				<tabpanel>
					<grid sclass="form" visible="@load(vm.visualizzaTotali)">
						<rows>
							<row>
								<cell width="110px">Totale prenotazioni:</cell>
								<cell>
									<label value="@load(empty vm.totalePrenotazioni ? 0:vm.totalePrenotazioni )  @converter('formatedNumber', format='###,##0.00')"/> €
								</cell>
								<cell width="170px">Totale variazione prenotazioni:</cell>
								<cell>
									<label value="@load(empty vm.totalePrenotazioniVariazioni ? 0:vm.totalePrenotazioniVariazioni )  @converter('formatedNumber', format='###,##0.00')"/> €
								</cell>
							</row>
						</rows>
					</grid>
					<listbox model="@bind(vm.listaMovimenti)" emptyMessage="Nessuna Prenotazione Contabile" vflex="1">
						<listhead>
							<listheader label="Prenotazione"	width="110px" />
							<listheader label="Var." width="30px" />
							<listheader label="Codice globale"	width="90px" visible="@load(vm.visualizzaCodiceGlobale)" />
							<listheader label="Num. Capitolo"	width="90px" />
							<listheader label="Capitolo"	width="40%" />
							<listheader label="Importo"	width="70px" />
							<listheader label="Descrizione"	width="30%" />
							<listheader label="Beneficiario" width="30%" visible="@load(vm.isRicercaAnagrafica)" />
							<listheader label="" width="40px" align="center">
								<image width="15px" src="/images/afc/16x16/add.png"
								  	onClick="@command('onAggiungiMovimentoContabile', movimento=null, tipologia='PRENOTAZIONE')"
									visible="@load(vm.competenzaInModifica and not vm.campiProtetti.CONTABILITA)"
								  	tooltiptext="Aggiungi Prenotazione"
								  	style="cursor: pointer;"
								/>
                      		</listheader>
						</listhead>
						<template name="model" var="c">
							<listitem onDoubleClick="@command('onModificaMovimento', movimento = c.id)" visible="@load(c.tipoDettaglio eq 'PRENOTAZIONE')">
								<listcell>
									<label value="@bind(c:cat3(c.annoEsercizio,' / ', c.progressivoEsterno))" />
									<h:br />
									<label value="Pren. originaria: "  visible="@load(c.opera eq 'PRENOTAZIONE_VARIAZIONE')" style="font-weight: bold;" />
									<label value="@bind(c:cat3(c.annoEsercizio,' / ', c.numeroVariazione))" visible="@load(c.opera eq 'PRENOTAZIONE_VARIAZIONE')" style="font-weight: bold;" />
								</listcell>
								<listcell>
									<image src="/images/agsde2/16x16/viewok.png"
										   tooltiptext="Variazione di prenotazione"
										   visible="@load(c.opera eq 'PRENOTAZIONE_VARIAZIONE')" />
								</listcell>
								<listcell visible="@load(vm.visualizzaCodiceGlobale)"><label value="@load(c.codiceGlobale)"/></listcell>
								<listcell><label value="@load(c.numero)"/></listcell>
								<listcell><label value="@load(c.descrizioneCapitolo)"/></listcell>
								<listcell><label value="@load(c.importo) @converter('formatedNumber', format='###,##0.00')"/></listcell>
								<listcell><label value="@load(c.descrizione)"/></listcell>
								<listcell><label value="@load(c.ragioneSociale eq null ? c:cat3(c.cognome, ' ', c.nome) : c.ragioneSociale)"/></listcell>
								<listcell>
									<image src="/images/agsde2/16x16/trash.png"
										 onClick="@command('onEliminaMovimento', idMovimentoContabile=c.id)"
										 tooltiptext="Elimina movimento"
										 visible="@load(vm.competenzaInModifica and not vm.campiProtetti.CONTABILITA)"
										 style="cursor: pointer;" />
								</listcell>
							</listitem>
						</template>
					</listbox>
				</tabpanel>

				<!-- sub-impegni -->
				<tabpanel>
					<grid sclass="form" visible="@load(vm.visualizzaTotali)">
						<rows>
							<row>
								<cell width="110px">Totale sub-impegni:</cell>
								<cell>
									<label value="@load(empty vm.totaleSubImpegni ? 0:vm.totaleSubImpegni)  @converter('formatedNumber', format='###,##0.00')"/> €
								</cell>
								<cell width="170px">Totale variazione sub-impegni:</cell>
								<cell>
									<label value="@load(empty vm.totaleSubImpegniVariazioni ? 0:vm.totaleSubImpegniVariazioni)  @converter('formatedNumber', format='###,##0.00')"/> €
								</cell>
							</row>
						</rows>
					</grid>
					<listbox model="@bind(vm.listaMovimenti)" emptyMessage="Nessuna SubImpegno" vflex="1">
						<listhead>
							<listheader label="Sub-impegno"	width="110px" />
							<listheader label="Var." width="30px" />
							<listheader label="Codice globale"	width="90px" visible="@load(vm.visualizzaCodiceGlobale)" />
							<listheader label="Num. Capitolo" width="90px" />
							<listheader label="Capitolo" width="40%" />
							<listheader label="Importo"	width="70px" />
							<listheader label="Descrizione"	width="30%" />
							<listheader label="Beneficiario" width="30%" visible="@load(vm.isRicercaAnagrafica)" />
							<listheader label="" width="40px" align="center">
								<image width="15px" src="/images/afc/16x16/add.png"
									   onClick="@command('onAggiungiMovimentoContabile', tipologia='SUBIMPEGNO')"
									   visible="@load(vm.competenzaInModifica and not vm.campiProtetti.CONTABILITA)"
									   tooltiptext="Aggiungi SubImpegno"
									   style="cursor: pointer;"
								/>
							</listheader>
						</listhead>

						<template name="model" var="c">
							<listitem onDoubleClick="@command('onModificaMovimento', movimento = c.id)" visible="@load(c.tipoDettaglio eq 'SUBIMPEGNO')">
								<listcell>
									<label value="@bind(c:cat3(c.annoEsercizio,' / ', c.progressivoEsterno))" />
									<h:br />
									<label value="Imp. originario: " style="font-weight: bold;" />
									<label value="@bind(c:cat3(c.annoEsercizio,' / ', c.numeroImpegnoPadre))" style="font-weight: bold;" />
								</listcell>
								<listcell>
									<image src="/images/agsde2/16x16/viewok.png"
										   tooltiptext="Variazione di sub-impegno"
										   visible="@load(c.opera eq 'SUBIMPEGNO_VARIAZIONE')" />
								</listcell>
								<listcell visible="@load(vm.visualizzaCodiceGlobale)"><label value="@load(c.codiceGlobale)"/></listcell>
								<listcell><label value="@load(c.numero)"/></listcell>
								<listcell><label value="@load(c.descrizioneCapitolo)"/></listcell>
								<listcell><label value="@load(c.importo) @converter('formatedNumber', format='###,##0.00')"/></listcell>
								<listcell><label value="@load(c.descrizione)"/></listcell>
								<listcell><label value="@load(c.ragioneSociale eq null ? c:cat3(c.cognome, ' ', c.nome) : c.ragioneSociale)"/></listcell>
								<listcell>
									<image src="/images/agsde2/16x16/trash.png"
										   onClick="@command('onEliminaMovimento', idMovimentoContabile=c.id)"
										   tooltiptext="Elimina movimento"
										   visible="@load(vm.competenzaInModifica and not vm.campiProtetti.CONTABILITA)"
										   style="cursor: pointer;" />
								</listcell>
							</listitem>
						</template>
					</listbox>
				</tabpanel>
			</tabpanels>
		</tabbox>
	</window>
</zk>