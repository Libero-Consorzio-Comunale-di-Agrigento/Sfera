<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/atti.css"?>

<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:h="http://www.w3.org/1999/xhtml"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window apply="grailsBindComposer" viewModel="@id('vm') @init('popupRicercaDizionariAtsPaviaViewModel')" border="normal" width="500px" height="500px" title=" ">

		<h:div class="barraTitoloPagina">
			<label sclass="titoloPagina" value="@load(vm.titolo)" />
		</h:div>

		<groupbox closable="false">
		<caption>Selezione</caption>
		<grid sclass="form">
			<rows>
				<row>
					<cell align='right' width="100px">
						<label value="Codice" />
					</cell>
					<cell>
						<textbox value="@bind(vm.codice)" width="80px" />
					</cell>
					<cell align='right' width="150px" rowspan="2">
						<button image="/images/afc/16x16/search.png" mold="trendy" label="Ricerca" onClick="@command('onRicerca', codice=vm.codice, descrizione=vm.descrizione)"/>
					</cell>
				</row>
				<row>
					<cell align='right' width="150px">
						<label value="Descrizione" />
					</cell>
					<cell>
						<textbox value="@bind(vm.descrizione)" width="180px" />
					</cell>
				</row>
			</rows>
		</grid >
		</groupbox>

		<groupbox closable="false" style="background-color: #ffffff !important;" vflex="1">
			<listbox model="@load(vm.listaDizionari)" selectedItem="@bind(vm.dizionarioSelezionato)" emptyMessage="Nessun valore trovato"
				height="250px" checkmark="true" multiple="false"  style="overflow-x:hidden; overflow-y:auto">
				<listhead>
					<listheader label="" width="50px" />
					<listheader label="Codice" width="150px" />
					<listheader label="Descrizione" />
				</listhead>
				<template name="model" var="documento">
					<listitem>
						<listcell label=""/>
						<listcell label="@load(documento.codice)"/>
						<listcell label="@load(documento.descrizione)"/>
					</listitem>
				</template>
			</listbox>

			<hlayout sclass="z-paging paginazione" onCreate="@command('onSelect')">
				<paging hflex="1" activePage="@load((vm.startFrom / (vm.maxResults eq 0 ? 1 : vm.maxResults)))"
						pageSize="@load(vm.maxResults le 0 ? 0 : vm.maxResults)"
						totalSize="@load(vm.listaDizionari.getTotalCount())" onPaging="@command('onPagina')"/>
				<label hflex="1"
					   value="@load(c:cat('Numero documenti trovati: ', (empty vm.listaDizionari ? 0 : vm.listaDizionari.getTotalCount())))"/>
			</hlayout>
		</groupbox>
			<h:div class="barraPulsanti">
				<h:div>
					<button mold="trendy" image="/images/afc/16x16/save.png"  label="Salva" 		 onClick="@command('onSalva')" 		 />
					<button mold="trendy" image="/images/afc/16x16/close.png" label="Chiudi" 		 onClick="@command('onChiudi')" 	 />
				</h:div>
			</h:div>

	</window>
</zk>