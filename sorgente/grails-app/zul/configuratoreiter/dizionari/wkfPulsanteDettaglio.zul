<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:w="http://www.zkoss.org/2005/zk/client"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window apply="grailsBindComposer"
            viewModel="@id('vm') @init('wkfPulsanteDettaglioViewModel')"
            border="normal"
            height="600px"
            width="800px"
            title=" "
            sizable="true">

        <h:div class="barraTitoloPagina">
            <label sclass="titoloPagina"
                   value="@load(c:cat('Gestione Pulsante', (empty vm.wkfPulsanteDto.etichetta? '': c:cat( ' - ', vm.wkfPulsanteDto.etichetta)) ) )"/>
            <image
                    src="@load(vm.wkfPulsanteDto.valido? '/images/configuratore/22x22/viewok.png' : '/images/configuratore/22x22/cancel.png')"
                    tooltiptext="@load(vm.wkfPulsanteDto.valido? 'Documento attivo' : 'Documento disattivato')"/>
        </h:div>

        <tabbox vflex="1">
            <tabs>
                <tab label="Dati"/>
                <tab label="Pulsanti competenze"/>
                <tab label="Utilizzato in..."/>
            </tabs>
            <tabpanels vflex="1">
                <tabpanel vflex="1">
                    <grid sclass="form" vflex="1">
                        <rows>
                            <row>
                                <cell align="right" width="20%">
                                    <h:span class="mandatoryLabel">*</h:span>
                                    <label value="Etichetta"/>
                                </cell>
                                <cell  width="30%">
                                    <textbox value="@bind(vm.wkfPulsanteDto.etichetta)" hflex="1"/>
                                </cell>
                                <cell align="right" width="20%">
                                    <label value="Tipo Oggetto"/>
                                </cell>
                                <cell  width="30%">
                                    <combobox model="@load(vm.listaTipoOggetto)" hflex="1"
                                              onChange="@command('onCambiaTipoOggetto')"
                                              selectedItem="@bind(vm.selectedTipoOggetto) @converter('it.finmatica.zkutils.PropertyConverter', property='codice')">
                                        <template name="model" var="tipoOgg">
                                            <comboitem label="@load(tipoOgg.nome)" value="@load(tipoOgg)"/>
                                        </template>
                                    </combobox>
                                </cell>
                            </row>
                            <row>
                                <cell align="right">
                                    <label value="Tooltip"/>
                                </cell>
                                <cell>
                                    <textbox value="@bind(vm.wkfPulsanteDto.tooltip)" hflex="1"/>
                                </cell>
                                <cell align="right">
                                    <label value="Icona"/>
                                </cell>
                                <cell>
                                    <hlayout>
                                        <image src="@bind(vm.wkfPulsanteDto.icona)"></image>
                                        <combobox model="@load(vm.listaImmaginiPulsante)" hflex="1"
                                                  selectedItem="@bind(vm.wkfPulsanteDto.icona)">
                                            <template name="model" var="elemento">
                                                <comboitem image="@load(elemento)"
                                                           label="@load(vm.getFileName(elemento))"
                                                           value="@load(elemento)"/>
                                            </template>
                                        </combobox>
                                    </hlayout>
                                </cell>
                            </row>
                            <row>
                                <cell align="right">
                                    <label value="Condizione Visibilità"/>
                                </cell>
                                <cell>
                                    <combobox model="@bind(vm.listaCondizioneVisibilita)" hflex="1"
                                              selectedItem="@bind(vm.wkfPulsanteDto.condizioneVisibilita) @converter('it.finmatica.zkutils.PropertyConverter', property='id')">
                                        <template name="model" var="condVis">
                                            <comboitem label="@load(condVis.nome)" value="@load(condVis)"/>
                                        </template>
                                    </combobox>
                                </cell>
                                <cell align="right">
                                    <image popup="helpCompetenze" src="/images/agsde2/16x16/info.png" />
                                    <popup id="helpCompetenze">
                                        <label value="Indica se il pulsante salva il documento con i dati in maschera prima di eseguire le proprie azioni. Normalmente è 'SI'. Per alcuni pulsanti che non operano direttamente sul documento (ad es. 'apri un altro applicativo') si può impostare NO in modo da non salvare il documento." />
                                    </popup>
                                    <h:span class="mandatoryLabel">*</h:span>
                                    <label value="Il pulsante salva il documento:"/>
                                </cell>
                                <cell>
                                    <radiogroup
                                            selectedIndex="@load(vm.wkfPulsanteDto.competenzaInModifica ? 0 : 1)"
                                            selectedItem="@save(vm.wkfPulsanteDto.competenzaInModifica)">
                                        <radio label="Sì" value="@load(true)"/>
                                        <radio label="No" value="@load(false)"/>
                                    </radiogroup>
                                </cell>
                            </row>
                            <row>
                                <cell align="right">
                                    <label value="Messaggio di Conferma"/>
                                </cell>
                                <cell colspan="3">
                                    <textbox value="@bind(vm.wkfPulsanteDto.messaggioConferma)" hflex="1"/>
                                </cell>
                            </row>
                            <row>
                                <cell align="right">
                                    <h:span class="mandatoryLabel">*</h:span>
                                    <label value="Descrizione"/>
                                </cell>
                                <cell colspan="3">
                                    <textbox value="@bind(vm.wkfPulsanteDto.descrizione)" multiline="true" rows="2" hflex="1" class="noresizable"/>
                                </cell>
                            </row>
                        </rows>
                    </grid>
                    <hlayout vflex="1">
                        <!-- Sezione dedicata alla lista dei comandi selezionabili -->
                        <listbox model="@load(vm.listaAzioniDisponibili)"
                                 selectedItem="@bind(vm.azioneDaAggiungere)"
                                 emptyMessage="Nessuna azione selezionabile"
                                 droppable="true"
                                 onDrop="@command('onDropDeleteAzione')"
                                 hflex="1" vflex="1">
                            <listhead>
                                <listheader vflex="max">
                                    <label value="Azioni disponibili"/>
                                    <textbox width="120px"
                                             mold="rounded"
                                             value="@bind(vm.filtro)"
                                             tooltiptext='#{empty arg.filtroTooltip?"Filtro per la ricerca":arg.filtroTooltip}'
                                             onOK="@command('onFiltro')"
                                             onChange="@command('onFiltro')"/>
                                    <toolbarbutton image="/images/afc/22x22/search.png"
                                                   tooltiptext='#{empty arg.searchTooltip?"Ricerca":arg.searchTooltip}'
                                                   visible="#{empty arg.searchVisible?true:arg.searchVisible}"
                                                   onClick="@command('onFiltro')" />
                                </listheader>
                            </listhead>
                            <template name="model" var="azioneSelezionabile">
                                <listitem onDoubleClick="" draggable="true" droppable="true"
                                          onDrop="@command('onDropDeleteAzione')">
                                    <custom-attributes azioneAggiungereDrag="#{azioneSelezionabile}"/>
                                    <listcell label="@load(azioneSelezionabile.nome)" tooltiptext="@load(azioneSelezionabile.descrizione)" />
                                </listitem>
                            </template>
                        </listbox>
                        <!--  Sezione dedicata ai bottoni per spostare gli oggetti -->
                        <vlayout width="50px" vflex="1">
                            <space vflex="1"/>
                            <button image="/images/afc/22x22/next.png"
                                    tooltiptext='Aggiungi azione'
                                    onClick="@command('onAggiungiAzione')"/>
                            <button image="/images/afc/22x22/prev.png"
                                    tooltiptext='Rimuovi azione'
                                    onClick="@command('onEliminaAzione')"/>
                            <space vflex="1"/>
                        </vlayout>
                        <!-- Sezione dedicata alla lista dei comandi selezionati -->
                        <listbox model="@load(vm.wkfPulsanteDto.azioni)"
                                 selectedItem="@bind(vm.selectedAzione)"
                                 emptyMessage="Nessuna azione assegnata."
                                 droppable="true"
                                 onDrop="@command('onDropInsertAzione')"
                                 vflex="1" hflex="1">
                            <listhead>
                                <listheader label="Azioni selezionate"/>
                            </listhead>
                            <template name="model" var="azioneInserita">
                                <listitem onDoubleClick="" draggable="true" droppable="true" onDrop="@command('onDropInsertAzione')">
                                    <custom-attributes azioneInseritaDrag="#{azioneInserita}"/>
                                    <listcell label="@load(azioneInserita.nome)" tooltiptext="@load(azioneInserita.descrizione)" />
                                </listitem>
                            </template>
                        </listbox>

                        <!--  Sezione dedicata ai bottoni per spostare gli oggetti -->
                        <vlayout width="50px" vflex="1
">
                            <space vflex="1"/>
                            <button image="/images/afc/22x22/up_blu.png"
                                    tooltiptext='Sposta in alto'
                                    onClick="@command('onSpostaSuAzione')"/>
                            <button image="/images/afc/22x22/down_blu.png"
                                    tooltiptext='Sposta in basso'
                                    onClick="@command('onSpostaGiuAzione')"/>
                            <space vflex="1"/>
                        </vlayout>
                    </hlayout>
                </tabpanel>

                <!-- pulsanti competenze -->
                <tabpanel vflex="1">
                    <vlayout vflex="1">
                        <groupbox closable="false">
                            <caption label="Attori"/>

                            <hlayout>
                                <listbox rows="7" hflex="1" vflex="1" selectedItem="@bind(vm.selectedAttore)"
                                         model="@bind(vm.listaAttori)">
                                    <template name="model" var="attore">
                                        <listitem draggable="true">
                                            <listcell label="@load(attore.nome)"/>
                                            <custom-attributes attore="#{attore}"/>
                                        </listitem>
                                    </template>
                                </listbox>
                                <groupbox vflex="min" mold="3d" hflex="3">
                                    <caption label="Descrizione attore"/>
                                    <grid sclass="form">
                                        <rows>
                                            <row>
                                                <cell>
                                                    <label value="Nome"/>
                                                </cell>
                                                <cell colspan="1">
                                                    <label value="@load(vm.selectedAttore.nome)"/>
                                                </cell>
                                                <cell>
                                                    <label value="Utente"/>
                                                </cell>
                                                <cell colspan="1">
                                                    <label value="@load(vm.selectedAttore.utenteAd4.nominativo)"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell>
                                                    <label value="Ruolo"/>
                                                </cell>
                                                <cell colspan="1">
                                                    <label value="@load(vm.selectedAttore.ruoloAd4.ruolo)"
                                                           tooltip="@load(vm.selectedAttore.ruoloAd4.descrizione)"/>
                                                </cell>
                                                <cell>
                                                    <label value="Unità organizzativa"/>
                                                </cell>
                                                <cell colspan="1">
                                                    <label value="@load(vm.selectedAttore.unitaSo4.descrizione)"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell>
                                                    <label value="Descrizione"/>
                                                </cell>
                                                <cell colspan="3">
                                                    <label value="@load(vm.selectedAttore.descrizione)"/>
                                                </cell>
                                            </row>
                                            <row>
                                                <cell>
                                                    <label value="Metodo di calcolo"/>
                                                </cell>
                                                <cell colspan="3">
                                                    <label value="@load(vm.selectedAttore.metodoDiCalcolo.nome)"/>
                                                </cell>
                                            </row>
                                        </rows>
                                    </grid>
                                </groupbox>
                            </hlayout>
                        </groupbox>

                        <listbox model="@load(vm.wkfPulsanteDto.cfgCompetenze)"
                                 onDrop="@command('onDropCompetenzaPulsante')" droppable="true" vflex="1">
                            <custom-attributes cfgPulsante="#{cfgPulsante}"/>
                            <listhead>
                                <listheader label="Attore"/>
                                <listheader label="Oggetto"/>
                                <listheader label="Lettura"/>
                                <listheader label="Modifica"/>
                                <listheader label="Cancellazione"/>
                                <listheader/>
                            </listhead>
                            <template name="model" var="competenza">
                                <listitem>
                                    <listcell label="@load(competenza.attore.nome)"/>
                                    <listcell>
                                        <combobox hflex="1" model="@load(vm.gerarchiaSelectedTipoOggetto)"
                                                  selectedItem="@bind(competenza.tipoOggetto) @converter('it.finmatica.zkutils.PropertyConverter', property='codice')">
                                            <template name="model" var="oggetto">
                                                <comboitem label="@load(oggetto.nome)" value="@load(oggetto)"/>
                                            </template>
                                        </combobox>
                                    </listcell>
                                    <listcell>
                                        <checkbox checked="@bind(competenza.lettura)"
                                                  disabled="@load(competenza.modifica)"/>
                                    </listcell>
                                    <listcell>
                                        <checkbox checked="@bind(competenza.modifica)"
                                                  disabled="@load(competenza.cancellazione)"/>
                                    </listcell>
                                    <listcell>
                                        <checkbox checked="@bind(competenza.cancellazione)"/>
                                    </listcell>
                                    <listcell>
                                        <toolbarbutton
                                                image="/images/afc/22x22/delete.png"
                                                onClick="@command('onEliminaCompetenza', comp = competenza) "/>
                                    </listcell>

                                </listitem>
                            </template>
                        </listbox>
                    </vlayout>
                </tabpanel>
                <tabpanel vflex="1">
                    <listbox model="@load(vm.listaUsoPulsante)"
                             emptyMessage="Questo Pulsante non è usato da nessuno step." vflex="1">
                        <listhead>
                            <listheader
                                    image="@load(vm.visualizzaTutti ? '/images/configuratore/16x16/point_green_red.png' : '/images/configuratore/16x16/point_green.png')"
                                    hoverImage="@load(vm.visualizzaTutti ? '/images/configuratore/16x16/point_green.png' : '/images/configuratore/16x16/point_green_red.png')"
                                    onClick="@command('onVisualizzaTutti')" width="20%"/>
                            <listheader label="Iter" width="40%"/>
                            <listheader label="Step" width="40%"/>
                        </listhead>
                        <template name="model">
                            <listitem
                                    onDoubleClick="@command('onApriIter', idIter=each.idIter, idStep=each.idStep, competenza=each.competenza)">
                                <listcell
                                        label="@load(each.statoIter eq 'IN_USO' ? 'In Uso' : (each.statoIter eq 'IN_PREPARAZIONE' ? 'In preparazione' : 'Fuori Uso'))"/>
                                <listcell label="@load(each.nomeIter)"/>
                                <listcell label="@load(each.nomeStep)"/>
                            </listitem>
                        </template>
                    </listbox>
                </tabpanel>
            </tabpanels>
        </tabbox>

        <!-- Inizio informazioni relative al salvataggio e bottoni salva / chiudi -->
        <vlayout sclass="datiCreazioneModifica" height="30px">
            <label value="@bind(vm.datiCreazione)" visible="@bind(not empty vm.wkfPulsanteDto.id)"/>
            <label value="@bind(vm.datiModifica)" visible="@bind(not empty vm.wkfPulsanteDto.id)"/>
        </vlayout>

        <h:div class="barraPulsanti">
            <button
                    mold="trendy"
                    image="@load(vm.wkfPulsanteDto.valido? '/images/afc/16x16/cancel.png' : '/images/afc/16x16/ok.png')"
                    label="@load(vm.wkfPulsanteDto.valido? 'Disattiva' : 'Ripristina')"
                    tooltiptext="@load(vm.wkfPulsanteDto.valido? 'Disattiva' : 'Ripristina')"
                    onClick="@command('onSettaValido', valido=!vm.wkfPulsanteDto.valido)"
                    visible="@bind(not empty vm.wkfPulsanteDto.id)"
                    width="100px"/>
            <h:div>
                <button

                        mold="trendy"
                        label="Salva"
                        onClick="@command('onSalva')"/>
                <button
                        mold="trendy"
                        label="Salva e chiudi"
                        onClick="@command('onSalvaChiudi')"/>
                <button
                        mold="trendy"
                        label="Chiudi"
                        onClick="@command('onChiudi')"/>
            </h:div>
        </h:div>
    </window>
</zk>