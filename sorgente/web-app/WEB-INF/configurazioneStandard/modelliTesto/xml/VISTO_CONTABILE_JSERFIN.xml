	<queryes>
		<query id='visto'
			   help_query_alias="v"
			   help_field_aliases="ANNO_PROPOSTA, ANNO_DETERMINA, ANNO_DETERMINA_2, AREA_PROPONENTE, CODICE_UNITA_PROPONENTE, DATA_DETERMINA, DATA_FIRMA, DATA_STAMPA, DATA_PROPOSTA, DIRIGENTE_VISTO, ESITO_VISTO, ESITO_VISTO_DEFINITIVO, FIRMATARIO, NOTE_CONTABILI, NOTE_VISTO, NUMERO_DETERMINA, NUMERO_DETERMINA_2, NUMERO_PROPOSTA, OGGETTO_DETERMINA, SERVIZIO_PROPONENTE, SUDDIVISIONE, UNITA_PROPONENTE, ASCENDENTI_UNITA, CIG, DESCRIZIONE_FIRMATARIO, DELEGANTE, TIPOLOGIA_PROPOSTA, TIPOLOGIA_VISTO, CODICE_UNITA_VISTO, SUDDIVISIONE_VISTO, UNITA_VISTO, DATA_FIRMA_PROPOSTA, ART_COMMA, NUMERO_MOVIMENTI">
			select decode(d.numero_determina, null, '${documentRoot.visto.NUMERO_DETERMINA}', d.numero_determina) NUMERO_DETERMINA
			,  decode(d.numero_determina, null, '${documentRoot.visto.DATA_DETERMINA}', to_char (d.data_numero_determina, 'dd/mm/yyyy')) DATA_DETERMINA
			,  decode(d.numero_determina, null, '${documentRoot.visto.ANNO_DETERMINA}', d.anno_determina) ANNO_DETERMINA
			,  decode(d.numero_determina_2, null, '${documentRoot.visto.NUMERO_DETERMINA_2}', d.numero_determina_2) NUMERO_DETERMINA_2
			,  decode(d.numero_determina_2, null, '${documentRoot.visto.ANNO_DETERMINA_2}', d.anno_determina_2) ANNO_DETERMINA_2
			,  d.numero_proposta NUMERO_PROPOSTA
			,  d.anno_proposta ANNO_PROPOSTA
			,  decode(d.data_numero_proposta, null, '${documentRoot.visto.DATA_PROPOSTA}', to_char(d.data_numero_proposta,'dd/mm/yyyy'))  DATA_PROPOSTA
			,  utility_pkg.get_suddivisione_uo_determina (d.id_determina) SUDDIVISIONE
			,  utility_pkg.get_unita_prop_determina (d.id_determina) UNITA_PROPONENTE
			,  utility_pkg.get_codice_unita_prop_dete (d.id_determina) CODICE_UNITA_PROPONENTE
			,  utility_pkg.get_uo_descrizione (vp.unita_progr, vp.unita_dal) UNITA_VISTO
			,  utility_pkg.get_codice_unita (vp.unita_progr, vp.unita_dal) CODICE_UNITA_VISTO
			,  utility_pkg.get_suddivisione_vistoparere (vp.id_visto_parere) SUDDIVISIONE_VISTO
			,  d.oggetto OGGETTO_DETERMINA
			,  d.note_contabili NOTE_CONTABILI
			,  decode(vp.esito, 'DA_VALUTARE', '${documentRoot.visto.ESITO_VISTO}', replace(vp.esito,'_',' ')) ESITO_VISTO
			,  decode(nvl(f.utente_firmatario_effettivo, f.utente_firmatario),null,'${documentRoot.visto.ESITO_VISTO_DEFINITIVO}', replace(vp.esito,'_',' ')) ESITO_VISTO_DEFINITIVO
			,  vp.note NOTE_VISTO
			,  nvl(to_char(f.data_firma, 'dd/mm/yyyy'), '${documentRoot.visto.DATA_FIRMA}') DATA_FIRMA
			,  to_char(sysdate,'dd/mm/yyyy') DATA_STAMPA
			,  nvl(utility_pkg.get_nominativo_soggetto (utility_pkg.get_ni_soggetto (nvl(f.utente_firmatario_effettivo, f.utente_firmatario)), d.ente), '${documentRoot.visto.FIRMATARIO}') FIRMATARIO
			,  decode(nvl(f.utente_firmatario_effettivo, f.utente_firmatario),null,'${documentRoot.visto.DESCRIZIONE_FIRMATARIO}', utility_pkg.get_descrizione_firmatario(nvl(f.utente_firmatario_effettivo, f.utente_firmatario), d.ente)) DESCRIZIONE_FIRMATARIO
			,  decode(nvl(f.utente_firmatario_effettivo, f.utente_firmatario),null,'${documentRoot.visto.DELEGANTE}', utility_pkg.get_delegante(f.utente_firmatario_effettivo, f.utente_firmatario, d.ente)) DELEGANTE
			,  nvl(utility_pkg.get_cognome_nome(utility_pkg.get_ni_soggetto (vp.utente_firmatario), vp.ente), '${documentRoot.visto.DIRIGENTE_VISTO}') DIRIGENTE_VISTO
			,  utility_pkg.get_desc_ascendenti_unita(utility_pkg.get_codice_unita_prop_dete (d.id_determina), null, impostazioni_pkg.get_impostazione('OTTICA_SO4', d.ente), null) ASCENDENTI_UNITA
			,  utility_pkg.get_suddivisione_determina (d.id_determina, 'SO4_SUDDIVISIONE_AREA', d.ente) AREA_PROPONENTE
			,  utility_pkg.get_suddivisione_determina (d.id_determina, 'SO4_SUDDIVISIONE_SERVIZIO', d.ente) SERVIZIO_PROPONENTE
			,  d.cig CIG
			, td.titolo TIPOLOGIA_PROPOSTA
			, tvp.titolo TIPOLOGIA_VISTO
			, nvl (to_char ((select max (data_firma) data_firma_proposta
			from firmatari fp
			where fp.firmato = 'Y' and fp.id_determina = d.id_determina)
			, 'dd/mm/yyyy'), '${documentRoot.visto.DATA_FIRMA_PROPOSTA}') DATA_FIRMA_PROPOSTA
		    , (select art_comma
			  from (select 'Visto di regolarita'' contabile attestante la copertura finanziaria
				(art. 183, comma 7 del D.LGS. 267 del 18/8/2000)' art_comma,
						   1   priorita
					  from movimenti_contabili mv, visti_pareri vp
					 where vp.id_visto_parere = #id
					   and mv.id_documento = vp.id_determina
					   and mv.tipo_uscita = 'U'
					union
					select 'Visto di regolarita'' contabile
				ai sensi art. 179, comma 3 del D.LGS. 267 del 18/8/2000' art_comma,
						   2   priorita
					  from movimenti_contabili mv, visti_pareri vp
					 where vp.id_visto_parere = #id
					   and mv.id_documento = vp.id_determina
					   and tipo_uscita = 'E'
					order by priorita)
			 where rownum = 1) art_comma,
			(select count(1)
			   from movimenti_contabili
			  where id_documento = d.id_determina
			    and tipo_documento = 'DETERMINA') numero_movimenti
			from  determine d
			,  visti_pareri vp
			,  firmatari f
			, tipi_determina td
			, tipi_visto_parere tvp
			where vp.id_visto_parere = #id
			and vp.id_determina = d.id_determina
			and d.id_tipo_determina = td.id_tipo_determina
			and vp.id_tipologia = tvp.id_tipo_visto_parere
			and f.id_visto_parere(+) = vp.id_visto_parere
			and f.data_firma(+) is not null
			and f.firmato(+) = 'N'
		</query>
		<query id='movimenti_anagrafica'
			   child="movimenti"
			   help_descrizione="Ritorna le anagrafiche legate ai movimenti contabili."
			   help_query_alias="ma"
			   help_field_aliases="RAGIONE_SOCIALE, COGNOME, NOME, CODICE_FISCALE, PARTITA_IVA, INDIRIZZO, CIVICO, COMUNE, CAP, SIGLA_PROVINCIA, TOTALE_U, TOTALE_E">
select distinct m.id_documento,
                ma.id_movimento_anagrafica ID_MOVIMENTO_ANAGRAFICA,
                ma.ragione_sociale RAGIONE_SOCIALE,
                ma.cognome COGNOME,
                ma.nome NOME,
                ma.codice_fiscale CODICE_FISCALE,
                ma.partita_iva PARTITA_IVA,
                ma.indirizzo INDIRIZZO,
                ma.civico CIVICO,
                ma.comune COMUNE,
                ma.cap CAP,
                ma.sigla_provincia SIGLA_PROVINCIA,
                (select trim(TO_CHAR(abs(sum(m1.importo)), '999G999G999G990D99', 'NLS_NUMERIC_CHARACTERS = '',.'''))
			       from movimenti_contabili m1
                  where m1.tipo_uscita = 'U'
                    and nvl(m1.id_movimento_anagrafica, -9999) = nvl(m.id_movimento_anagrafica, -9999)
                    and m1.id_documento = vp.id_determina
                    and m1.tipo_documento = 'DETERMINA') TOTALE_U,
                (select trim(TO_CHAR(abs(sum(m1.importo)), '999G999G999G990D99', 'NLS_NUMERIC_CHARACTERS = '',.'''))
                   from movimenti_contabili m1
                  where m1.tipo_uscita = 'E'
                    and nvl(m1.id_movimento_anagrafica, -9999) = nvl(m.id_movimento_anagrafica, -9999)
                    and m1.id_documento = vp.id_determina
                    and m1.tipo_documento = 'DETERMINA') TOTALE_E
  from visti_pareri         vp,
       movimenti_contabili  m,
       movimenti_anagrafica ma
 where vp.id_visto_parere = #id
   and m.id_documento = vp.id_determina
   and m.id_movimento_anagrafica = ma.id_movimento_anagrafica(+)
union
select cast(null as number) id_documento,
       cast(null as number) ID_MOVIMENTO_ANAGRAFICA,
       cast(null as varchar2(255)) RAGIONE_SOCIALE,
       cast(null as varchar2(255)) COGNOME,
       cast(null as varchar2(255)) NOME,
       cast(null as varchar2(255)) CODICE_FISCALE,
       cast(null as varchar2(255)) PARTITA_IVA,
       cast(null as varchar2(255)) INDIRIZZO,
       cast(null as varchar2(255)) CIVICO,
       cast(null as varchar2(255)) COMUNE,
       cast(null as varchar2(255)) CAP,
       cast(null as varchar2(255)) SIGLA_PROVINCIA,
       cast(null as varchar2(255)) TOTALE_U,
       cast(null as varchar2(255)) TOTALE_E
  from dual
 where not exists
 (select 1
          from visti_pareri         vp,
               movimenti_contabili  m,
               movimenti_anagrafica ma
         where vp.id_visto_parere = #id
           and m.id_documento = vp.id_determina
           and m.id_movimento_anagrafica = ma.id_movimento_anagrafica(+))
 order by ragione_sociale asc,
          cognome         asc,
          nome            asc
		</query>
		<query id='movimenti'
			   help_descrizione="Ritorna i movimenti contabili"
			   help_query_alias="m"
			   help_field_aliases="TIPO_MOVIMENTO, CAPITOLO, OPERAZIONE, NUMERO_CAPITOLO, DESCRIZIONE_CAPITOLO, ANNO_ESERCIZIO, NUMERO_MOVIMENTO, CODICE_LIVELLO_5, DESCRIZIONE_LIVELLO_5, IMPORTO, CIG_MOVIMENTO, CUP_MOVIMENTO, CODICE_GLOBALE, CODICE_TIPO_FINANZIAMENTO, TIPO_FINANZIAMENTO, CODICE_LAVORO, DESCRIZIONE_LAVORO, CODICE_CENTRO_GESTORE, DESCRIZIONE_CENTRO_GESTORE">
select case
		 when m.opera = 'ACCERTAMENTO' then 1
         when m.opera = 'ACCERTAMENTO_VARIAZIONE' then 2
         when m.opera = 'IMPEGNO' then 3
         when m.opera = 'IMPEGNO_VARIAZIONE' then 4
         when m.opera = 'SUBIMPEGNO' then 5
         when m.opera = 'SUBIMPEGNO_VARIAZIONE' then 6
         when m.opera = 'IMPEGNO_PRENOTAZIONE' then 7
         when m.opera = 'PRENOTAZIONE' then 8
         when m.opera = 'PRENOTAZIONE_VARIAZIONE' then 9
       end ORDINAMENTO_1,
       M.ANNO_ESERCIZIO ORDINAMENTO_2,
       case
         when m.opera = 'PRENOTAZIONE' then (m.progressivo_esterno)
         when m.opera = 'PRENOTAZIONE_VARIAZIONE' then (m.numero_variazione)
         when m.opera = 'IMPEGNO' then (m.progressivo_esterno)
         when m.opera = 'IMPEGNO_PRENOTAZIONE' then (m.progressivo_esterno)
         when m.opera = 'IMPEGNO_VARIAZIONE' then (m.numero_variazione)
         when m.opera = 'SUBIMPEGNO' then (m.progressivo_esterno)
         when m.opera = 'SUBIMPEGNO_VARIAZIONE' then TO_NUMBER(m.numero_impegno_padre)
         when m.opera = 'ACCERTAMENTO' then (m.progressivo_esterno)
         when m.opera = 'ACCERTAMENTO_VARIAZIONE' then (m.numero_variazione)
       end ORDINAMENTO_3,
		m.tipo_uscita TIPO_MOVIMENTO,
       case
         when m.opera = 'PRENOTAZIONE' then 'prenotazione'
         when m.opera = 'PRENOTAZIONE_VARIAZIONE' then 'variazione di prenotazione'
         when m.opera = 'IMPEGNO' then 'impegno'
         when m.opera = 'IMPEGNO_PRENOTAZIONE' then 'impegno su prenotazione'
         when m.opera = 'IMPEGNO_VARIAZIONE' then 'variazione di impegno'
         when m.opera = 'SUBIMPEGNO' then 'sub-impegno'
         when m.opera = 'SUBIMPEGNO_VARIAZIONE' then 'variazione di sub-impegno'
         when m.opera = 'ACCERTAMENTO' then 'accertamento'
         when m.opera = 'ACCERTAMENTO_VARIAZIONE' then 'variazione di accertamento'
       end OPERAZIONE,
       m.capitolo CAPITOLO,
       m.numero NUMERO_CAPITOLO,
       m.descrizione_capitolo DESCRIZIONE_CAPITOLO,
       m.anno_esercizio ANNO_ESERCIZIO,
       m.pdc_liv_5 CODICE_LIVELLO_5,
       m.descrizione_pdc_liv_5 DESCRIZIONE_LIVELLO_5,
       case
         when m.opera = 'PRENOTAZIONE' then to_char(m.progressivo_esterno)
         when m.opera = 'PRENOTAZIONE_VARIAZIONE' then to_char(m.numero_variazione)
         when m.opera = 'IMPEGNO' then to_char(m.progressivo_esterno)
         when m.opera = 'IMPEGNO_PRENOTAZIONE' then to_char(m.progressivo_esterno)
         when m.opera = 'IMPEGNO_VARIAZIONE' then to_char(m.numero_variazione)
         when m.opera = 'SUBIMPEGNO' then to_char(m.progressivo_esterno)
         when m.opera = 'SUBIMPEGNO_VARIAZIONE' then to_char(m.numero_impegno_padre)
         when m.opera = 'ACCERTAMENTO' then to_char(m.progressivo_esterno)
         when m.opera = 'ACCERTAMENTO_VARIAZIONE' then to_char(m.numero_variazione)
       end NUMERO_MOVIMENTO,
       m.cig CIG_MOVIMENTO,
       m.cup CUP_MOVIMENTO,
       m.codice_globale CODICE_GLOBALE,
       m.cod_tipo_finanz CODICE_TIPO_FINANZIAMENTO,
       m.des_tipo_finanz TIPO_FINANZIAMENTO,
       m.cod_lavoro CODICE_LAVORO,
       m.des_lavoro DESCRIZIONE_LAVORO,
       m.codice_centro_gestore CODICE_CENTRO_GESTORE,
       m.descrizione_centro_gestore DESCRIZIONE_CENTRO_GESTORE,
       trim(TO_CHAR(m.importo, '999G999G999G990D99', 'NLS_NUMERIC_CHARACTERS = '',.''')) IMPORTO,
       m.numero
  from movimenti_contabili m
 where m.id_documento = @ID_DOCUMENTO
   and m.tipo_documento = 'DETERMINA'
   and nvl(m.id_movimento_anagrafica, -9999) = nvl(@ID_MOVIMENTO_ANAGRAFICA, -9999)
union all
select cast(null as number) ORDINAMENTO_1,
		cast(null as number) ORDINAMENTO_2,
		cast(null as number) ORDINAMENTO_3,
        cast(null as varchar2(255)) TIPO_MOVIMENTO,
        cast(null as varchar2(50)) OPERAZIONE,
        cast(null as varchar2(255)) CAPITOLO,
        cast(null as number) NUMERO_CAPITOLO,
        cast(null as varchar2(4000)) DESCRIZIONE_CAPITOLO,
        cast(null as number) ANNO_ESERCIZIO,
        cast(null as varchar2(255)) CODICE_LIVELLO_5,
        cast(null as varchar2(4000)) DESCRIZIONE_LIVELLO_5,
        cast(null as varchar2(255)) NUMERO_MOVIMENTO,
        cast(null as varchar2(255)) CIG_MOVIMENTO,
        cast(null as varchar2(255)) CUP_MOVIMENTO,
        cast(null as varchar2(255)) CODICE_GLOBALE,
        cast(null as varchar2(255)) CODICE_TIPO_FINANZIAMENTO,
        cast(null as varchar2(255)) TIPO_FINANZIAMENTO,
        cast(null as varchar2(255)) CODICE_LAVORO,
        cast(null as varchar2(4000)) DESCRIZIONE_LAVORO,
        cast(null as varchar2(255)) CODICE_CENTRO_GESTORE,
        cast(null as varchar2(4000)) DESCRIZIONE_CENTRO_GESTORE,
        cast(null as varchar2(30)) IMPORTO,
        cast(null as number) NUMERO
  from dual
 where not exists (select 1
          from movimenti_contabili m
         where m.id_documento = @ID_DOCUMENTO
           and m.tipo_documento = 'DETERMINA'
           and nvl(m.id_movimento_anagrafica, -9999) = nvl(@ID_MOVIMENTO_ANAGRAFICA, -9999))
 order by ordinamento_1    asc,
             ordinamento_2    asc,
             ordinamento_3    asc,
             numero           	asc,
             anno_esercizio   	asc,
             codice_livello_5  asc
		</query>
	</queryes>
	<staticData />
