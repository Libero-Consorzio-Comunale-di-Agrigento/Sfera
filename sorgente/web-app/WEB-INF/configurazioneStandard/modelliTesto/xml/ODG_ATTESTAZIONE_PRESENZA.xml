	<queryes>
		<query id='titoloReport' help_query_alias="t" help_field_aliases="DAL, AL, TITOLO_COMMISSIONE">
			<![CDATA[select distinct #dal DAL, #al AL, decode( #id,-1,'TUTTE LE COMMISSIONI',com.titolo)  TITOLO_COMMISSIONE from odg_commissioni com where (#id < 0 or com.id_commissione = #id)]]>
		</query>
		<query id='nominativi' child="presenze, numero_presenze" help_query_alias="n" help_field_aliases="COGNOME, NOME"><![CDATA[
		   select distinct decode (sp.ni_componente_esterno,
						 null, utility_pkg.get_cognome (cc.ni_componente),
						 utility_pkg.get_cognome (sp.ni_componente_esterno)) as COGNOME,
						 decode (sp.ni_componente_esterno,
						 null, utility_pkg.get_nome (cc.ni_componente),
						 utility_pkg.get_nome (sp.ni_componente_esterno)) as NOME,
				 nvl(cc.ni_componente, sp.ni_componente_esterno) as NI_COMPONENTE,
				 #id as ID,
				 #dal as DAL,
				 #al as AL,
				 #ni as NI
			from odg_commissioni c,
				 odg_sedute s,
				 odg_sedute_partecipanti sp,
				 odg_oggetti_seduta os,
				 odg_oggetti_partecipanti op,
				 odg_commissioni_componenti cc
		   where os.id_seduta = s.id_seduta
			 and s.id_commissione = c.id_commissione
			 and op.id_oggetto_seduta = os.id_oggetto_seduta
			 and sp.id_seduta_partecipante = op.id_seduta_partecipante
			 and cc.id_commissione_componente(+) = sp.id_commissione_componente
			 and sp.presente = 'Y'
			 and sp.data_entrata is not null
			 and ( #id < 0 or s.id_commissione = #id)
			 and trunc (s.data_inizio_seduta) >= to_date ( #dal, 'dd/mm/yyyy')
			 and trunc (s.data_inizio_seduta) <= to_date ( #al, 'dd/mm/yyyy')
			 and ( #ni < 0 or cc.ni_componente = #ni or sp.ni_componente_esterno = #ni)
		order by 1 asc, 2 asc
		]]></query>
		<query id='presenze' help_query_alias="p" help_field_aliases="DATA_SEDUTA, DATA_ENTRATA, DATA_USCITA, ORA_ENTRATA, ORA_USCITA, TITOLO_COMMISSIONE">
				<![CDATA[
					  select distinct to_char(s.data_seduta,'dd/mm/yyyy') DATA_SEDUTA,
					 to_char(sp.data_entrata,'dd/mm/yyyy') DATA_ENTRATA,
					 to_char(sp.data_uscita,'dd/mm/yyyy') DATA_USCITA,
					 sp.ora_entrata ORA_ENTRATA,
					 sp.ora_uscita ORA_USCITA,
					 c.titolo TITOLO_COMMISSIONE,
					 nvl(sp.data_entrata, s.data_seduta) data_ordinamento
				from odg_commissioni c,
					 odg_sedute s,
					 odg_sedute_partecipanti sp,
					 odg_commissioni_componenti cc
	 		   where s.id_commissione = c.id_commissione
				 and s.id_seduta = sp.id_seduta
				 and cc.id_commissione_componente(+) = sp.id_commissione_componente
				 and sp.presente = 'Y'
				 and s.valido = 'Y'
				 and sp.data_entrata is not null
				 and ( @ID < 0 or c.id_commissione = @ID)
				 and trunc (s.data_inizio_seduta) >= to_date ( @DAL, 'dd/mm/yyyy')
				 and trunc (s.data_inizio_seduta) <= to_date ( @AL, 'dd/mm/yyyy')
				 and (cc.ni_componente = nvl(@NI_COMPONENTE,-1) or sp.ni_componente_esterno = nvl(@NI_COMPONENTE,-1))
			order by data_ordinamento asc, sp.ora_entrata
			]]>
		</query>
		<query id='numero_presenze' help_query_alias="np" help_field_aliases="TOTALE_PRESENZE">
			<![CDATA[
					  select count(1) totale_presenze
				from odg_commissioni c,
					 odg_sedute s,
					 odg_sedute_partecipanti sp,
					 odg_commissioni_componenti cc
	 		   where s.id_commissione = c.id_commissione
				 and s.id_seduta = sp.id_seduta
				 and cc.id_commissione_componente(+) = sp.id_commissione_componente
				 and sp.presente = 'Y'
				 and s.valido = 'Y'
				 and sp.data_entrata is not null
				 and ( @ID < 0 or c.id_commissione = @ID)
				 and trunc (s.data_inizio_seduta) >= to_date ( @DAL, 'dd/mm/yyyy')
				 and trunc (s.data_inizio_seduta) <= to_date ( @AL, 'dd/mm/yyyy')
				 and (cc.ni_componente = nvl(@NI_COMPONENTE,-1) or sp.ni_componente_esterno = nvl(@NI_COMPONENTE,-1))
			]]>
		</query>
	</queryes>
